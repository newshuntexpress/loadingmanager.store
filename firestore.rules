rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 4.1: Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Pillar 3: Reusable hardened primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function cleanEmailLower() {
      return isSignedIn() && request.auth.token.email is string
        ? request.auth.token.email.lower()
        : '';
    }

    function callerEmailKey() {
      return cleanEmailLower()
        .replace('[@]', '_at_')
        .replace('[.]', '_dot_')
        .replace('[^a-z0-9_-]', '_');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isBootstrappedAdmin() {
      return isEmailVerified() && cleanEmailLower() == 'newshuntexpress@gmail.com';
    }

    function hasActiveAllowlistDoc() {
      return isEmailVerified() &&
        callerEmailKey().size() >= 3 &&
        exists(/databases/$(database)/documents/authorized_emails/$(callerEmailKey())) &&
        get(/databases/$(database)/documents/authorized_emails/$(callerEmailKey())).data.isActive == true;
    }

    function isAdmin() {
      return isEmailVerified() && (
        isBootstrappedAdmin() ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (
          hasActiveAllowlistDoc() &&
          get(/databases/$(database)/documents/authorized_emails/$(callerEmailKey())).data.roleName == 'admin'
        )
      );
    }

    function isActiveAllowlisted() {
      return isEmailVerified() && (isBootstrappedAdmin() || isAdmin() || hasActiveAllowlistDoc());
    }

    function canAccessPlant(plantId) {
      return isAdmin() || (
        hasActiveAllowlistDoc() && (
          !('allowedPlants' in get(/databases/$(database)/documents/authorized_emails/$(callerEmailKey())).data) ||
          get(/databases/$(database)/documents/authorized_emails/$(callerEmailKey())).data.allowedPlants.hasAny(['ALL', plantId])
        )
      );
    }

    function isValidRoleName(roleName) {
      return roleName is string &&
        roleName.size() <= 40 &&
        roleName in [
          'admin',
          'user',
          'mmd_manager',
          'view_only',
          'forklift_operator',
          'liquid_store_operator',
          'ex_factory_operator',
          'security_guard'
        ];
    }

    function isValidPlantCode(plantId) {
      return plantId is string &&
        plantId.size() >= 1 &&
        plantId.size() <= 32 &&
        plantId.matches('^[A-Z0-9_\\-]+$');
    }

    function isValidUserPublicProfile(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'roleName', 'isActive', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'displayName', 'roleName', 'isActive', 'createdAt', 'updatedAt']) &&
        isValidId(data.uid) &&
        data.uid == userId &&
        data.displayName is string &&
        data.displayName.size() >= 1 &&
        data.displayName.size() <= 120 &&
        isValidRoleName(data.roleName) &&
        data.isActive is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidUserPrivateInfo(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'providerId', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'email', 'photoURL', 'providerId', 'createdAt', 'updatedAt']) &&
        isValidId(data.uid) &&
        data.uid == userId &&
        data.email is string &&
        data.email.size() >= 3 &&
        data.email.size() <= 254 &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 512)) &&
        data.providerId is string &&
        data.providerId.size() >= 1 &&
        data.providerId.size() <= 64 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidAuthorizedUserRecord(data, userId) {
      return data.keys().hasAll(['id', 'username', 'displayName', 'roleName', 'isActive', 'authorizedBy', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly([
          'id',
          'username',
          'displayName',
          'email',
          'roleName',
          'isActive',
          'permissions',
          'allowedPlants',
          'defaultPlantId',
          'signatureDataUrl',
          'authorizedBy',
          'ownerUid',
          'createdAt',
          'updatedAt'
        ]) &&
        isValidId(data.id) &&
        data.id == userId &&
        data.username is string &&
        data.username.size() >= 3 &&
        data.username.size() <= 32 &&
        data.username.matches('^[a-zA-Z0-9._-]+$') &&
        data.displayName is string &&
        data.displayName.size() >= 2 &&
        data.displayName.size() <= 120 &&
        (!('email' in data) || (data.email is string && data.email.size() <= 254)) &&
        isValidRoleName(data.roleName) &&
        data.isActive is bool &&
        (!('permissions' in data) || (data.permissions is list && data.permissions.size() <= 50 && (data.permissions.size() == 0 || (data.permissions[0] is string && data.permissions[0].size() <= 64)))) &&
        (!('allowedPlants' in data) || (data.allowedPlants is list && data.allowedPlants.size() >= 1 && data.allowedPlants.size() <= 20 && isValidPlantCode(data.allowedPlants[0]))) &&
        (!('defaultPlantId' in data) || isValidPlantCode(data.defaultPlantId)) &&
        (!('signatureDataUrl' in data) || (data.signatureDataUrl is string && data.signatureDataUrl.size() <= 300000)) &&
        data.authorizedBy is string &&
        data.authorizedBy.size() >= 1 &&
        data.authorizedBy.size() <= 120 &&
        (!('ownerUid' in data) || isValidId(data.ownerUid)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidAuthorizedEmailRecord(data, emailKey) {
      return data.keys().hasAll([
          'emailKey',
          'userId',
          'username',
          'displayName',
          'email',
          'roleName',
          'isActive',
          'permissions',
          'allowedPlants',
          'defaultPlantId',
          'authorizedBy',
          'ownerUid',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'emailKey',
          'userId',
          'username',
          'displayName',
          'email',
          'roleName',
          'isActive',
          'permissions',
          'allowedPlants',
          'defaultPlantId',
          'signatureDataUrl',
          'authorizedBy',
          'ownerUid',
          'createdAt',
          'updatedAt'
        ]) &&
        isValidId(data.emailKey) &&
        data.emailKey == emailKey &&
        isValidId(data.userId) &&
        data.username is string &&
        data.username.size() >= 3 &&
        data.username.size() <= 32 &&
        data.username.matches('^[a-zA-Z0-9._-]+$') &&
        data.displayName is string &&
        data.displayName.size() >= 1 &&
        data.displayName.size() <= 120 &&
        data.email is string &&
        data.email.size() >= 3 &&
        data.email.size() <= 254 &&
        isValidRoleName(data.roleName) &&
        data.isActive is bool &&
        data.permissions is list &&
        data.permissions.size() <= 50 &&
        (data.permissions.size() == 0 || (data.permissions[0] is string && data.permissions[0].size() <= 64)) &&
        data.allowedPlants is list &&
        data.allowedPlants.size() >= 1 &&
        data.allowedPlants.size() <= 20 &&
        isValidPlantCode(data.allowedPlants[0]) &&
        isValidPlantCode(data.defaultPlantId) &&
        (!('signatureDataUrl' in data) || (data.signatureDataUrl is string && data.signatureDataUrl.size() <= 300000)) &&
        data.authorizedBy is string &&
        data.authorizedBy.size() >= 1 &&
        data.authorizedBy.size() <= 120 &&
        isValidId(data.ownerUid) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidAdminRegistryEntry(data, userId) {
      return data.keys().hasAll(['uid', 'role', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'role', 'createdAt']) &&
        isValidId(data.uid) &&
        data.uid == userId &&
        data.role is string &&
        data.role.size() <= 20 &&
        data.role == 'admin' &&
        data.createdAt is timestamp;
    }

    function isValidAuditLogEntry(data, logId) {
      return data.keys().hasAll(['id', 'ownerUid', 'actorUsername', 'actorRole', 'action', 'targetType', 'details', 'createdAt']) &&
        data.keys().hasOnly(['id', 'ownerUid', 'actorUsername', 'actorRole', 'action', 'targetType', 'targetId', 'details', 'createdAt']) &&
        isValidId(data.id) &&
        data.id == logId &&
        isValidId(data.ownerUid) &&
        data.actorUsername is string && data.actorUsername.size() >= 1 && data.actorUsername.size() <= 64 &&
        data.actorRole is string && data.actorRole.size() >= 1 && data.actorRole.size() <= 40 &&
        data.action is string && data.action.size() >= 1 && data.action.size() <= 64 &&
        data.targetType is string && data.targetType.size() >= 1 && data.targetType.size() <= 32 &&
        (!('targetId' in data) || (data.targetId is string && data.targetId.size() <= 128)) &&
        data.details is string && data.details.size() <= 500 &&
        data.createdAt is timestamp;
    }

    function isValidPlantSettings(data, settingId) {
      return data.keys().hasAll(['id', 'ownerUid', 'companyName', 'settingsJson', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'ownerUid', 'companyName', 'companySubtitle', 'settingsJson', 'updatedBy', 'createdAt', 'updatedAt']) &&
        isValidId(data.id) &&
        data.id == settingId &&
        isValidId(data.ownerUid) &&
        data.companyName is string && data.companyName.size() >= 1 && data.companyName.size() <= 160 &&
        (!('companySubtitle' in data) || (data.companySubtitle is string && data.companySubtitle.size() <= 160)) &&
        data.settingsJson is string && data.settingsJson.size() >= 2 && data.settingsJson.size() <= 350000 &&
        (!('updatedBy' in data) || (data.updatedBy is string && data.updatedBy.size() <= 120)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidLoadingSlip(slip) {
      return slip is map &&
        slip.keys().hasAll(['delNoteNumber', 'placeName', 'items', 'totalQty', 'totalPallets', 'totalLooseRolls', 'preparedBy', 'checkedBy', 'createdAt']) &&
        slip.keys().hasOnly([
          'delNoteNumber',
          'placeName',
          'items',
          'totalQty',
          'totalPallets',
          'totalLooseRolls',
          'preparedBy',
          'checkedBy',
          'loadedBy',
          'storeInchargeUserId',
          'storeInchargeName',
          'storeInchargeSignatureDataUrl',
          'driverSignatureNotes',
          'createdAt',
          'isLocked',
          'loadingCompletedAt',
          'loadingCompletedTime',
          'loadingCompletedBy'
        ]) &&
        slip.delNoteNumber is string && slip.delNoteNumber.size() <= 64 &&
        slip.placeName is string && slip.placeName.size() <= 160 &&
        slip.items is list && slip.items.size() <= 50 && (slip.items.size() == 0 || slip.items[0] is map) &&
        slip.totalQty is number &&
        slip.totalPallets is number &&
        slip.totalLooseRolls is number &&
        slip.preparedBy is string && slip.preparedBy.size() <= 120 &&
        slip.checkedBy is string && slip.checkedBy.size() <= 120 &&
        (!('loadedBy' in slip) || (slip.loadedBy is string && slip.loadedBy.size() <= 120)) &&
        (!('storeInchargeUserId' in slip) || (slip.storeInchargeUserId is string && slip.storeInchargeUserId.size() <= 128)) &&
        (!('storeInchargeName' in slip) || (slip.storeInchargeName is string && slip.storeInchargeName.size() <= 120)) &&
        (!('storeInchargeSignatureDataUrl' in slip) || (slip.storeInchargeSignatureDataUrl is string && slip.storeInchargeSignatureDataUrl.size() <= 300000)) &&
        (!('driverSignatureNotes' in slip) || (slip.driverSignatureNotes is string && slip.driverSignatureNotes.size() <= 500)) &&
        slip.createdAt is string && slip.createdAt.size() <= 64 &&
        (!('isLocked' in slip) || slip.isLocked is bool) &&
        (!('loadingCompletedAt' in slip) || slip.loadingCompletedAt is number) &&
        (!('loadingCompletedTime' in slip) || (slip.loadingCompletedTime is string && slip.loadingCompletedTime.size() <= 32)) &&
        (!('loadingCompletedBy' in slip) || (slip.loadingCompletedBy is string && slip.loadingCompletedBy.size() <= 120));
    }

    function isValidGateTicket(data, ticketId) {
      return data.keys().hasAll([
          'id',
          'ticketNumber',
          'sequenceNumber',
          'date',
          'timeIn',
          'gateNumber',
          'gateSequenceNumber',
          'truckNumber',
          'driverName',
          'status',
          'ownerUid',
          'isSharedPlant',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id',
          'plantId',
          'ticketNumber',
          'sequenceNumber',
          'date',
          'timeIn',
          'timeCalled',
          'timeLoadingStarted',
          'timeCompleted',
          'gateNumber',
          'gateSequenceNumber',
          'truckNumber',
          'driverName',
          'transporterName',
          'destinationPlace',
          'loadingType',
          'delNoteNumber',
          'status',
          'loadingSlip',
          'remarks',
          'priority',
          'version',
          'ownerUid',
          'isSharedPlant',
          'createdBy',
          'updatedBy',
          'createdAt',
          'updatedAt'
        ]) &&
        isValidId(data.id) &&
        data.id == ticketId &&
        (!('plantId' in data) || isValidPlantCode(data.plantId)) &&
        data.ticketNumber is string && data.ticketNumber.size() >= 1 && data.ticketNumber.size() <= 64 &&
        data.sequenceNumber is number && data.sequenceNumber >= 0 &&
        data.date is string && data.date.size() == 10 && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        data.timeIn is string && data.timeIn.size() <= 32 &&
        (!('timeCalled' in data) || (data.timeCalled is string && data.timeCalled.size() <= 32)) &&
        (!('timeLoadingStarted' in data) || (data.timeLoadingStarted is string && data.timeLoadingStarted.size() <= 32)) &&
        (!('timeCompleted' in data) || (data.timeCompleted is string && data.timeCompleted.size() <= 32)) &&
        data.gateNumber is string && data.gateNumber.size() >= 1 && data.gateNumber.size() <= 40 &&
        data.gateSequenceNumber is number && data.gateSequenceNumber >= 0 &&
        data.truckNumber is string && data.truckNumber.size() >= 1 && data.truckNumber.size() <= 40 &&
        data.driverName is string && data.driverName.size() >= 1 && data.driverName.size() <= 120 &&
        (!('transporterName' in data) || (data.transporterName is string && data.transporterName.size() <= 120)) &&
        (!('destinationPlace' in data) || (data.destinationPlace is string && data.destinationPlace.size() <= 160)) &&
        (!('loadingType' in data) || (data.loadingType is string && data.loadingType.size() <= 16 && data.loadingType in ['local', 'export', 'sto'])) &&
        (!('delNoteNumber' in data) || (data.delNoteNumber is string && data.delNoteNumber.size() <= 64)) &&
        data.status is string && data.status.size() <= 24 && data.status in ['waiting', 'called', 'under_loading', 'completed', 'cancelled'] &&
        (!('loadingSlip' in data) || isValidLoadingSlip(data.loadingSlip)) &&
        (!('remarks' in data) || (data.remarks is string && data.remarks.size() <= 500)) &&
        (!('priority' in data) || (data.priority is string && data.priority.size() <= 16 && data.priority in ['normal', 'urgent'])) &&
        (!('version' in data) || data.version is number) &&
        isValidId(data.ownerUid) &&
        data.isSharedPlant is bool &&
        (!('createdBy' in data) || (data.createdBy is string && data.createdBy.size() <= 120)) &&
        (!('updatedBy' in data) || (data.updatedBy is string && data.updatedBy.size() <= 120)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidTicketDriverPii(data, ticketId) {
      return data.keys().hasAll(['ticketId', 'ownerUid', 'driverPhone', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['ticketId', 'ownerUid', 'driverPhone', 'iqamaNumber', 'createdAt', 'updatedAt']) &&
        isValidId(data.ticketId) &&
        data.ticketId == ticketId &&
        isValidId(data.ownerUid) &&
        data.driverPhone is string && data.driverPhone.size() <= 32 &&
        (!('iqamaNumber' in data) || (data.iqamaNumber is string && data.iqamaNumber.size() <= 40)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidMaterialRecord(data, materialId) {
      return data.keys().hasAll(['id', 'materialName', 'packType', 'palletRatio', 'ownerUid', 'isSharedPlant', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'materialName', 'packType', 'palletRatio', 'remarks', 'ownerUid', 'isSharedPlant', 'createdBy', 'updatedBy', 'createdAt', 'updatedAt']) &&
        isValidId(data.id) &&
        data.id == materialId &&
        data.materialName is string && data.materialName.size() >= 1 && data.materialName.size() <= 160 &&
        data.packType is string && data.packType.size() >= 1 && data.packType.size() <= 40 &&
        data.palletRatio is number && data.palletRatio > 0 && data.palletRatio <= 10000 &&
        (!('remarks' in data) || (data.remarks is string && data.remarks.size() <= 300)) &&
        isValidId(data.ownerUid) &&
        data.isSharedPlant is bool &&
        (!('createdBy' in data) || (data.createdBy is string && data.createdBy.size() <= 120)) &&
        (!('updatedBy' in data) || (data.updatedBy is string && data.updatedBy.size() <= 120)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidExFactoryEntry(data, entryId) {
      return data.keys().hasAll([
          'id',
          'plantId',
          'entryDate',
          'delNoteNumber',
          'customerName',
          'truckNumber',
          'ownerUid',
          'isSharedPlant',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id',
          'plantId',
          'entryDate',
          'delNoteNumber',
          'customerName',
          'loadingType',
          'truckNumber',
          'driverName',
          'mobileNumber',
          'iqamaNumber',
          'loadingSlip',
          'ownerUid',
          'isSharedPlant',
          'createdBy',
          'updatedBy',
          'createdAt',
          'updatedAt'
        ]) &&
        isValidId(data.id) &&
        data.id == entryId &&
        isValidPlantCode(data.plantId) &&
        data.entryDate is string && data.entryDate.size() == 10 && data.entryDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        data.delNoteNumber is string && data.delNoteNumber.size() >= 1 && data.delNoteNumber.size() <= 64 &&
        data.customerName is string && data.customerName.size() >= 1 && data.customerName.size() <= 160 &&
        (!('loadingType' in data) || (data.loadingType is string && data.loadingType.size() <= 16 && data.loadingType in ['local', 'export', 'sto'])) &&
        data.truckNumber is string && data.truckNumber.size() >= 1 && data.truckNumber.size() <= 40 &&
        (!('driverName' in data) || (data.driverName is string && data.driverName.size() <= 120)) &&
        (!('mobileNumber' in data) || (data.mobileNumber is string && data.mobileNumber.size() <= 32)) &&
        (!('iqamaNumber' in data) || (data.iqamaNumber is string && data.iqamaNumber.size() <= 40)) &&
        (!('loadingSlip' in data) || isValidLoadingSlip(data.loadingSlip)) &&
        isValidId(data.ownerUid) &&
        data.isSharedPlant is bool &&
        (!('createdBy' in data) || (data.createdBy is string && data.createdBy.size() <= 120)) &&
        (!('updatedBy' in data) || (data.updatedBy is string && data.updatedBy.size() <= 120)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // Non-PII user profiles: ONLY Admins can create or delete; owners must already be active & allowlisted
    match /users/{userId} {
      allow get: if isValidId(userId) && (isAdmin() || (isOwner(userId) && isActiveAllowlisted()));
      allow list: if false;

      allow create: if isEmailVerified() &&
        isValidId(userId) &&
        isValidUserPublicProfile(incoming(), userId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (
          isAdmin() ||
          (
            isOwner(userId) &&
            isActiveAllowlisted() &&
            incoming().uid == request.auth.uid &&
            incoming().isActive == true &&
            incoming().roleName == get(/databases/$(database)/documents/authorized_emails/$(callerEmailKey())).data.roleName
          )
        );

      allow update: if isEmailVerified() &&
        isValidId(userId) &&
        isValidUserPublicProfile(incoming(), userId) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          (
            isAdmin() &&
            incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'roleName', 'isActive', 'updatedAt'])
          ) ||
          (
            isOwner(userId) &&
            isActiveAllowlisted() &&
            existing().isActive == true &&
            incoming().roleName == existing().roleName &&
            incoming().isActive == existing().isActive &&
            incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'updatedAt'])
          )
        );

      allow delete: if isValidId(userId) && isAdmin();

      // Master Gate + PII isolation subcollection
      match /private/{docId} {
        allow get: if isValidId(userId) && isValidId(docId) && docId == 'info' && (isAdmin() || (isOwner(userId) && isActiveAllowlisted()));
        allow list: if false;

        allow create: if isEmailVerified() &&
          isValidId(userId) &&
          isValidId(docId) &&
          docId == 'info' &&
          (isAdmin() || (isOwner(userId) && isActiveAllowlisted())) &&
          isValidUserPrivateInfo(incoming(), userId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          existsAfter(/databases/$(database)/documents/users/$(userId));

        allow update: if isEmailVerified() &&
          isValidId(userId) &&
          isValidId(docId) &&
          docId == 'info' &&
          (isAdmin() || (isOwner(userId) && isActiveAllowlisted() && exists(/databases/$(database)/documents/users/$(userId)))) &&
          isValidUserPrivateInfo(incoming(), userId) &&
          incoming().uid == existing().uid &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly(['email', 'photoURL', 'providerId', 'updatedAt']) &&
          exists(/databases/$(database)/documents/users/$(userId));

        allow delete: if isValidId(userId) && isValidId(docId) && isAdmin();
      }
    }

    // Admin-managed user authorization records (Create/Edit/Delete strictly restricted to Administrators)
    match /authorized_users/{userId} {
      allow get: if isValidId(userId) && (isAdmin() || (isActiveAllowlisted() && resource != null && existing().email == cleanEmailLower()));
      allow list: if isAdmin() || (isEmailVerified() && resource.data.ownerUid == request.auth.uid);

      allow create: if isAdmin() &&
        isValidId(userId) &&
        isValidAuthorizedUserRecord(incoming(), userId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isAdmin() &&
        isValidId(userId) &&
        isValidAuthorizedUserRecord(incoming(), userId) &&
        incoming().id == existing().id &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'username',
          'displayName',
          'email',
          'roleName',
          'isActive',
          'permissions',
          'allowedPlants',
          'defaultPlantId',
          'signatureDataUrl',
          'authorizedBy',
          'ownerUid',
          'updatedAt'
        ]);

      allow delete: if isValidId(userId) && isAdmin();
    }

    // Email-keyed allowlist enforced during Firebase login verification & plant/role lookups
    match /authorized_emails/{emailKey} {
      allow get: if isValidId(emailKey) && isEmailVerified() && (
        isAdmin() ||
        emailKey == callerEmailKey() ||
        (resource != null && existing().email == cleanEmailLower())
      );
      allow list: if isAdmin() || (isEmailVerified() && resource.data.ownerUid == request.auth.uid);

      allow create: if isAdmin() &&
        isValidId(emailKey) &&
        isValidAuthorizedEmailRecord(incoming(), emailKey) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isAdmin() &&
        isValidId(emailKey) &&
        isValidAuthorizedEmailRecord(incoming(), emailKey) &&
        incoming().emailKey == existing().emailKey &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'userId',
          'username',
          'displayName',
          'email',
          'roleName',
          'isActive',
          'permissions',
          'allowedPlants',
          'defaultPlantId',
          'signatureDataUrl',
          'authorizedBy',
          'ownerUid',
          'updatedAt'
        ]);

      allow delete: if isValidId(emailKey) && isAdmin();
    }

    // Trusted Admin Registry
    match /admins/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if false;
      allow create: if isEmailVerified() &&
        isValidId(userId) &&
        isValidAdminRegistryEntry(incoming(), userId) &&
        incoming().createdAt == request.time &&
        (isAdmin() || (isOwner(userId) && isBootstrappedAdmin()));
      allow update: if false;
      allow delete: if isValidId(userId) && isAdmin();
    }

    // Append-only Administrator Audit Logs
    match /audit_logs/{logId} {
      allow get: if isValidId(logId) && isAdmin();
      allow list: if isAdmin() || (isEmailVerified() && resource.data.ownerUid == request.auth.uid);
      allow create: if isAdmin() &&
        isValidId(logId) &&
        isValidAuditLogEntry(incoming(), logId) &&
        incoming().ownerUid == request.auth.uid &&
        incoming().createdAt == request.time;
      allow update, delete: if false;
    }

    // Shared Multi-Plant Settings (readable by active allowlisted users; writable only by Administrators)
    match /plant_settings/{settingId} {
      allow get: if isValidId(settingId) && isActiveAllowlisted();
      allow list: if isActiveAllowlisted();

      allow create: if isAdmin() &&
        isValidId(settingId) &&
        isValidPlantSettings(incoming(), settingId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isAdmin() &&
        isValidId(settingId) &&
        isValidPlantSettings(incoming(), settingId) &&
        incoming().id == existing().id &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'ownerUid',
          'companyName',
          'companySubtitle',
          'settingsJson',
          'updatedBy',
          'updatedAt'
        ]);

      allow delete: if isValidId(settingId) && isAdmin();
    }

    // Plant-Scoped Gate Queue Tickets & Loading Slips (restricted to active allowlisted users & permitted plants)
    match /gate_tickets/{ticketId} {
      allow get: if isValidId(ticketId) &&
        isActiveAllowlisted() &&
        (
          resource == null ||
          isAdmin() ||
          (
            (existing().ownerUid == request.auth.uid || existing().isSharedPlant == true) &&
            canAccessPlant(('plantId' in existing() && existing().plantId is string && existing().plantId != '') ? existing().plantId : 'RIYADH')
          )
        );

      allow list: if isEmailVerified() &&
        (resource.data.ownerUid == request.auth.uid || resource.data.isSharedPlant == true);

      allow create: if isActiveAllowlisted() &&
        isValidId(ticketId) &&
        isValidGateTicket(incoming(), ticketId) &&
        canAccessPlant(('plantId' in incoming() && incoming().plantId is string && incoming().plantId != '') ? incoming().plantId : 'RIYADH') &&
        incoming().ownerUid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isActiveAllowlisted() &&
        isValidId(ticketId) &&
        isValidGateTicket(incoming(), ticketId) &&
        canAccessPlant(('plantId' in existing() && existing().plantId is string && existing().plantId != '') ? existing().plantId : 'RIYADH') &&
        (!('id' in existing()) || incoming().id == existing().id) &&
        (!('ownerUid' in existing()) || incoming().ownerUid == existing().ownerUid) &&
        ((!('createdAt' in existing()) || !(existing().createdAt is timestamp)) && isAdmin() || incoming().createdAt == existing().createdAt) &&
        incoming().updatedAt == request.time &&
        (
          isAdmin() ||
          (
            (existing().ownerUid == request.auth.uid || existing().isSharedPlant == true) &&
            (!('plantId' in existing()) || !(existing().plantId is string) || existing().plantId == '' || incoming().plantId == existing().plantId) &&
            existing().status != 'completed' &&
            existing().status != 'cancelled' &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'plantId',
              'timeCalled',
              'timeLoadingStarted',
              'timeCompleted',
              'gateNumber',
              'gateSequenceNumber',
              'truckNumber',
              'driverName',
              'transporterName',
              'destinationPlace',
              'loadingType',
              'delNoteNumber',
              'status',
              'loadingSlip',
              'remarks',
              'priority',
              'version',
              'updatedBy',
              'updatedAt',
              'isSharedPlant',
              'driverPhone',
              'iqamaNumber',
              'autoLoadingMinutes',
              'autoUnderLoadingAt',
              'autoStatusUpdatedAt',
              'autoUnderLoadingApplied',
              'manualStatusOverride',
              'driverStatusToken'
            ])
          )
        );

      allow delete: if isValidId(ticketId) &&
        isActiveAllowlisted() &&
        (
          isAdmin() ||
          (existing().ownerUid == request.auth.uid && canAccessPlant(('plantId' in existing() && existing().plantId is string && existing().plantId != '') ? existing().plantId : 'RIYADH'))
        );

      // Isolated Driver Phone & Iqama PII
      match /private/{docId} {
        allow get: if isValidId(ticketId) &&
          isValidId(docId) &&
          docId == 'driver' &&
          isActiveAllowlisted() &&
          (isAdmin() || existing().ownerUid == request.auth.uid);

        allow list: if false;

        allow create: if isActiveAllowlisted() &&
          isValidId(ticketId) &&
          isValidId(docId) &&
          docId == 'driver' &&
          isValidTicketDriverPii(incoming(), ticketId) &&
          incoming().ownerUid == request.auth.uid &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          existsAfter(/databases/$(database)/documents/gate_tickets/$(ticketId));

        allow update: if isActiveAllowlisted() &&
          isValidId(ticketId) &&
          isValidId(docId) &&
          docId == 'driver' &&
          isValidTicketDriverPii(incoming(), ticketId) &&
          incoming().ticketId == existing().ticketId &&
          incoming().ownerUid == existing().ownerUid &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          (isAdmin() || existing().ownerUid == request.auth.uid) &&
          incoming().diff(existing()).affectedKeys().hasOnly(['driverPhone', 'iqamaNumber', 'updatedAt']) &&
          exists(/databases/$(database)/documents/gate_tickets/$(ticketId));

        allow delete: if isValidId(ticketId) &&
          isValidId(docId) &&
          docId == 'driver' &&
          isActiveAllowlisted() &&
          (isAdmin() || existing().ownerUid == request.auth.uid);
      }
    }

    // Material Master Records (strictly restricted to active Admin-allowlisted users)
    match /materials/{materialId} {
      allow get: if isValidId(materialId) &&
        isActiveAllowlisted() &&
        (resource == null || isAdmin() || existing().ownerUid == request.auth.uid || existing().isSharedPlant == true);

      allow list: if isEmailVerified() &&
        (resource.data.ownerUid == request.auth.uid || resource.data.isSharedPlant == true);

      allow create: if isActiveAllowlisted() &&
        isValidId(materialId) &&
        isValidMaterialRecord(incoming(), materialId) &&
        incoming().ownerUid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isActiveAllowlisted() &&
        isValidId(materialId) &&
        isValidMaterialRecord(incoming(), materialId) &&
        incoming().id == existing().id &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          isAdmin() ||
          (
            (existing().ownerUid == request.auth.uid || existing().isSharedPlant == true) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'materialName',
              'packType',
              'palletRatio',
              'remarks',
              'updatedBy',
              'updatedAt',
              'isSharedPlant'
            ])
          )
        );

      allow delete: if isValidId(materialId) &&
        isActiveAllowlisted() &&
        (isAdmin() || existing().ownerUid == request.auth.uid);
    }

    // Plant-Scoped Ex-Factory Dispatch Entries & Loading Slips
    match /ex_factory_entries/{entryId} {
      allow get: if isValidId(entryId) &&
        isActiveAllowlisted() &&
        (
          resource == null ||
          isAdmin() ||
          (
            (existing().ownerUid == request.auth.uid || existing().isSharedPlant == true) &&
            canAccessPlant(('plantId' in existing() && existing().plantId is string && existing().plantId != '') ? existing().plantId : 'RIYADH')
          )
        );

      allow list: if isEmailVerified() &&
        (resource.data.ownerUid == request.auth.uid || resource.data.isSharedPlant == true);

      allow create: if isActiveAllowlisted() &&
        isValidId(entryId) &&
        isValidExFactoryEntry(incoming(), entryId) &&
        canAccessPlant(incoming().plantId) &&
        incoming().ownerUid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isActiveAllowlisted() &&
        isValidId(entryId) &&
        isValidExFactoryEntry(incoming(), entryId) &&
        canAccessPlant(('plantId' in existing() && existing().plantId is string && existing().plantId != '') ? existing().plantId : 'RIYADH') &&
        incoming().id == existing().id &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          isAdmin() ||
          (
            (existing().ownerUid == request.auth.uid || existing().isSharedPlant == true) &&
            (!('plantId' in existing()) || !(existing().plantId is string) || existing().plantId == '' || incoming().plantId == existing().plantId)
          )
        );

      allow delete: if isValidId(entryId) &&
        isActiveAllowlisted() &&
        (
          isAdmin() ||
          (existing().ownerUid == request.auth.uid && canAccessPlant(('plantId' in existing() && existing().plantId is string && existing().plantId != '') ? existing().plantId : 'RIYADH'))
        );
    }

    // Connection check document (server check only; no public writes)
    match /test/{docId} {
      allow get: if isValidId(docId) && docId == 'connection' && isSignedIn();
      allow list, write: if false;
    }
  }
}
