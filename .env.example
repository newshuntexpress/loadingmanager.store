# Server Configuration (Hostinger / VPS / Local)
# NODE_ENV="production"
# PORT="3000"

# Persistent SQLite Database Location (recommended on Hostinger to keep DB outside redeployed build folder)
# DB_DIR="./data"
# DB_PATH="./data/app.db"

# Public Application URL (used for generating Driver Live Loading Status links in WhatsApp alerts)
# Example: https://dispatch.yourdomain.com
# APP_BASE_URL=""
# APP_URL=""

# Security & Session Timeout
# SESSION_IDLE_MINUTES="30"

# Default initial Administrator account (seeded automatically if no users exist in DB)
# Defaults to username "munnayadav" and password "Yadav@1977" if omitted.
# ADMIN_INITIAL_USERNAME="munnayadav"
# ADMIN_INITIAL_PASSWORD="Yadav@1977"

# WhatsApp Cloud API (Meta Business API) - Server-Side Only
# WHATSAPP_ACCESS_TOKEN=""
# WHATSAPP_PHONE_NUMBER_ID=""
# WHATSAPP_BUSINESS_ACCOUNT_ID=""
# WHATSAPP_API_VERSION="v21.0"

# Optional Gemini API key (only if AI features are enabled)
# GEMINI_API_KEY=""

# Optional Vite / GitHub Pages Base Path (defaults to "./")
# VITE_BASE_PATH="./"

# Optional Firebase Web Config Overrides (defaults to firebase-applet-config.json)
# VITE_FIREBASE_API_KEY=""
# VITE_FIREBASE_AUTH_DOMAIN=""
# VITE_FIREBASE_PROJECT_ID=""
# VITE_FIREBASE_STORAGE_BUCKET=""
# VITE_FIREBASE_MESSAGING_SENDER_ID=""
# VITE_FIREBASE_APP_ID=""
# VITE_FIREBASE_DATABASE_ID="ai-studio-gatepassloadings-9d9c194d-e2fc-43b8-894e-66a3317b3273"

