{
  "entities": {
    "UserPublicProfile": {
      "title": "UserPublicProfile",
      "description": "Non-PII Firebase user profile synced on sign-in for role and active status tracking.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID of the signed-in user.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "description": "Display name shown in the portal.",
          "minLength": 1,
          "maxLength": 120
        },
        "roleName": {
          "type": "string",
          "description": "Assigned GatePass portal role.",
          "enum": [
            "admin",
            "user",
            "mmd_manager",
            "view_only",
            "forklift_operator",
            "liquid_store_operator",
            "ex_factory_operator",
            "security_guard"
          ],
          "maxLength": 40
        },
        "isActive": {
          "type": "boolean",
          "description": "Whether the user account is active."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the user profile was first created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of the last profile update."
        }
      },
      "required": ["uid", "displayName", "roleName", "isActive", "createdAt", "updatedAt"]
    },
    "UserPrivateInfo": {
      "title": "UserPrivateInfo",
      "description": "Isolated PII document stored under /users/{userId}/private/info, readable and writable only by the owner or an administrator.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID of the owner.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Verified email address from Firebase Auth.",
          "minLength": 3,
          "maxLength": 254
        },
        "photoURL": {
          "type": "string",
          "description": "Optional avatar URL from Google Auth.",
          "maxLength": 512
        },
        "providerId": {
          "type": "string",
          "description": "Firebase authentication provider identifier.",
          "minLength": 1,
          "maxLength": 64
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when private info was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when private info was last updated."
        }
      },
      "required": ["uid", "email", "providerId", "createdAt", "updatedAt"]
    },
    "AuthorizedUserRecord": {
      "title": "AuthorizedUserRecord",
      "description": "Admin-managed user authorization record with permissions and allowedPlants; only Administrators may create, edit, or delete records.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Application user identifier.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "username": {
          "type": "string",
          "description": "Unique portal username.",
          "minLength": 3,
          "maxLength": 32,
          "pattern": "^[a-zA-Z0-9._-]+$"
        },
        "displayName": {
          "type": "string",
          "description": "Full display name of the authorized user.",
          "minLength": 2,
          "maxLength": 120
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Authorized email address for Firebase Google Login or username/email login.",
          "maxLength": 254
        },
        "roleName": {
          "type": "string",
          "description": "Assigned GatePass portal role.",
          "enum": [
            "admin",
            "user",
            "mmd_manager",
            "view_only",
            "forklift_operator",
            "liquid_store_operator",
            "ex_factory_operator",
            "security_guard"
          ],
          "maxLength": 40
        },
        "isActive": {
          "type": "boolean",
          "description": "Whether the user is authorized to access the application."
        },
        "permissions": {
          "type": "array",
          "description": "Allotted portal permission keys (bounded <= 50)."
        },
        "allowedPlants": {
          "type": "array",
          "description": "Authorized plant IDs (e.g. RIYADH, JEDDAH, or ALL; bounded <= 20)."
        },
        "defaultPlantId": {
          "type": "string",
          "description": "Default operational plant ID for this user.",
          "maxLength": 32
        },
        "signatureDataUrl": {
          "type": "string",
          "description": "Optional digital signature image data URL.",
          "maxLength": 300000
        },
        "authorizedBy": {
          "type": "string",
          "description": "Username or email of the Administrator who authorized this user.",
          "minLength": 1,
          "maxLength": 120
        },
        "ownerUid": {
          "type": "string",
          "description": "Firebase UID of the Administrator who last synced this authorization record.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when user authorization was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when user authorization was last modified."
        }
      },
      "required": ["id", "username", "displayName", "roleName", "isActive", "authorizedBy", "createdAt", "updatedAt"]
    },
    "AuthorizedEmailRecord": {
      "title": "AuthorizedEmailRecord",
      "description": "Email-keyed allowlist record enforced by Firebase Auth & Firestore security rules so only Admin-created active emails can access the portal and allotted plants.",
      "type": "object",
      "properties": {
        "emailKey": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "username": {
          "type": "string",
          "minLength": 3,
          "maxLength": 32,
          "pattern": "^[a-zA-Z0-9._-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 254
        },
        "roleName": {
          "type": "string",
          "enum": [
            "admin",
            "user",
            "mmd_manager",
            "view_only",
            "forklift_operator",
            "liquid_store_operator",
            "ex_factory_operator",
            "security_guard"
          ],
          "maxLength": 40
        },
        "isActive": {
          "type": "boolean"
        },
        "permissions": {
          "type": "array"
        },
        "allowedPlants": {
          "type": "array"
        },
        "defaultPlantId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "signatureDataUrl": {
          "type": "string",
          "maxLength": 300000
        },
        "authorizedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "emailKey",
        "userId",
        "username",
        "displayName",
        "email",
        "roleName",
        "isActive",
        "permissions",
        "allowedPlants",
        "defaultPlantId",
        "authorizedBy",
        "ownerUid",
        "createdAt",
        "updatedAt"
      ]
    },
    "AdminRegistryEntry": {
      "title": "AdminRegistryEntry",
      "description": "Trusted administrator marker document used by security rules for admin checks.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID of the administrator.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "role": {
          "type": "string",
          "description": "Fixed admin marker role.",
          "enum": ["admin"],
          "maxLength": 20
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when admin entry was created."
        }
      },
      "required": ["uid", "role", "createdAt"]
    },
    "AuditLogEntry": {
      "title": "AuditLogEntry",
      "description": "Append-only security and user-management audit log entry.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "actorUsername": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "actorRole": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "action": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "targetType": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "targetId": {
          "type": "string",
          "maxLength": 128
        },
        "details": {
          "type": "string",
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "ownerUid", "actorUsername", "actorRole", "action", "targetType", "details", "createdAt"]
    },
    "PlantSettings": {
      "title": "PlantSettings",
      "description": "Company branding, gates, and multi-plant configuration shared across active allowlisted users and editable only by Administrators.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "companyName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "companySubtitle": {
          "type": "string",
          "maxLength": 160
        },
        "settingsJson": {
          "type": "string",
          "minLength": 2,
          "maxLength": 350000
        },
        "updatedBy": {
          "type": "string",
          "maxLength": 120
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "ownerUid", "companyName", "settingsJson", "createdAt", "updatedAt"]
    },
    "GateTicketRecord": {
      "title": "GateTicketRecord",
      "description": "Operational gate queue ticket and nested loading slip scoped by plantId without raw driver phone or Iqama PII.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique gate ticket identifier.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "plantId": {
          "type": "string",
          "description": "Authorized plant identifier (e.g., RIYADH, JEDDAH).",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[A-Z0-9_\\-]+$"
        },
        "ticketNumber": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "sequenceNumber": {
          "type": "number"
        },
        "date": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "timeIn": {
          "type": "string",
          "maxLength": 32
        },
        "timeCalled": {
          "type": "string",
          "maxLength": 32
        },
        "timeLoadingStarted": {
          "type": "string",
          "maxLength": 32
        },
        "timeCompleted": {
          "type": "string",
          "maxLength": 32
        },
        "gateNumber": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "gateSequenceNumber": {
          "type": "number"
        },
        "truckNumber": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "driverName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "driverPhone": {
          "type": "string",
          "maxLength": 32
        },
        "iqamaNumber": {
          "type": "string",
          "maxLength": 40
        },
        "transporterName": {
          "type": "string",
          "maxLength": 120
        },
        "destinationPlace": {
          "type": "string",
          "maxLength": 160
        },
        "loadingType": {
          "type": "string",
          "enum": ["local", "export", "sto"],
          "maxLength": 16
        },
        "delNoteNumber": {
          "type": "string",
          "maxLength": 64
        },
        "status": {
          "type": "string",
          "enum": ["waiting", "called", "under_loading", "completed", "cancelled"],
          "maxLength": 24
        },
        "remarks": {
          "type": "string",
          "maxLength": 500
        },
        "priority": {
          "type": "string",
          "enum": ["normal", "urgent"],
          "maxLength": 16
        },
        "loadingSlip": {
          "type": "object",
          "description": "Optional nested 8-row loading slip map."
        },
        "version": {
          "type": "number"
        },
        "autoLoadingMinutes": {
          "type": "number"
        },
        "autoUnderLoadingAt": {
          "type": "number"
        },
        "autoStatusUpdatedAt": {
          "type": "number"
        },
        "autoUnderLoadingApplied": {
          "type": "boolean"
        },
        "manualStatusOverride": {
          "type": "boolean"
        },
        "driverStatusToken": {
          "type": "string",
          "maxLength": 256
        },
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "isSharedPlant": {
          "type": "boolean"
        },
        "createdBy": {
          "type": "string",
          "maxLength": 120
        },
        "updatedBy": {
          "type": "string",
          "maxLength": 120
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "ticketNumber",
        "sequenceNumber",
        "date",
        "timeIn",
        "gateNumber",
        "gateSequenceNumber",
        "truckNumber",
        "driverName",
        "status",
        "ownerUid",
        "isSharedPlant",
        "createdAt",
        "updatedAt"
      ]
    },
    "GateTicketDriverPii": {
      "title": "GateTicketDriverPii",
      "description": "Isolated driver phone and Iqama document stored under /gate_tickets/{ticketId}/private/driver.",
      "type": "object",
      "properties": {
        "ticketId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "driverPhone": {
          "type": "string",
          "maxLength": 32
        },
        "iqamaNumber": {
          "type": "string",
          "maxLength": 40
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["ticketId", "ownerUid", "driverPhone", "createdAt", "updatedAt"]
    },
    "MaterialMasterItem": {
      "title": "MaterialMasterItem",
      "description": "Plant Material Master catalog item with pack type and auto-pallet conversion ratio.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "materialName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "packType": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "palletRatio": {
          "type": "number"
        },
        "remarks": {
          "type": "string",
          "maxLength": 300
        },
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "isSharedPlant": {
          "type": "boolean"
        },
        "createdBy": {
          "type": "string",
          "maxLength": 120
        },
        "updatedBy": {
          "type": "string",
          "maxLength": 120
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "materialName",
        "packType",
        "palletRatio",
        "ownerUid",
        "isSharedPlant",
        "createdAt",
        "updatedAt"
      ]
    },
    "ExFactoryEntryRecord": {
      "title": "ExFactoryEntryRecord",
      "description": "Plant-scoped Ex-Factory Dispatch entry and optional nested 8-row loading slip.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "plantId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[A-Z0-9_\\-]+$"
        },
        "entryDate": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "delNoteNumber": {
          "type": "string",
          "maxLength": 64
        },
        "customerName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "loadingType": {
          "type": "string",
          "enum": ["local", "export", "sto"],
          "maxLength": 16
        },
        "truckNumber": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "driverName": {
          "type": "string",
          "maxLength": 120
        },
        "mobileNumber": {
          "type": "string",
          "maxLength": 32
        },
        "iqamaNumber": {
          "type": "string",
          "maxLength": 40
        },
        "loadingSlip": {
          "type": "object",
          "description": "Optional nested 8-row loading slip map."
        },
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "isSharedPlant": {
          "type": "boolean"
        },
        "createdBy": {
          "type": "string",
          "maxLength": 120
        },
        "updatedBy": {
          "type": "string",
          "maxLength": 120
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "plantId",
        "entryDate",
        "delNoteNumber",
        "customerName",
        "truckNumber",
        "ownerUid",
        "isSharedPlant",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserPublicProfile" },
      "description": "Admin-managed user profile document without PII."
    },
    "/users/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/UserPrivateInfo" },
      "description": "Owner- and admin-restricted PII subcollection."
    },
    "/authorized_users/{userId}": {
      "schema": { "$ref": "#/entities/AuthorizedUserRecord" },
      "description": "Admin-managed whitelist of authorized portal users including role, permissions, and allowedPlants."
    },
    "/authorized_emails/{emailKey}": {
      "schema": { "$ref": "#/entities/AuthorizedEmailRecord" },
      "description": "Email-keyed allowlist enforced by Firebase Auth verification and Firestore rules."
    },
    "/admins/{userId}": {
      "schema": { "$ref": "#/entities/AdminRegistryEntry" },
      "description": "Trusted admin registry collection."
    },
    "/audit_logs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLogEntry" },
      "description": "Append-only Administrator security & user-management audit logs."
    },
    "/plant_settings/{settingId}": {
      "schema": { "$ref": "#/entities/PlantSettings" },
      "description": "Shared multi-plant configuration and portal branding managed by Administrators."
    },
    "/gate_tickets/{ticketId}": {
      "schema": { "$ref": "#/entities/GateTicketRecord" },
      "description": "Gate queue tickets and nested loading slips synchronized in real time for signed-in users without role or plant save blockers."
    },
    "/gate_tickets/{ticketId}/private/{docId}": {
      "schema": { "$ref": "#/entities/GateTicketDriverPii" },
      "description": "Driver phone and Iqama details for gate tickets accessible to signed-in users."
    },
    "/materials/{materialId}": {
      "schema": { "$ref": "#/entities/MaterialMasterItem" },
      "description": "Material Master catalog for loading slip pallet calculations accessible to signed-in users."
    },
    "/ex_factory_entries/{entryId}": {
      "schema": { "$ref": "#/entities/ExFactoryEntryRecord" },
      "description": "Plant-scoped Ex-Factory Dispatch records and nested loading slips."
    }
  }
}
