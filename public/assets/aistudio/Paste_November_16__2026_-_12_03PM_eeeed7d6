                  <td>${esc(tx.material_name)}</td>
                  <td class="right mono ${isIn ? 'c-green' : 'c-red'}" style="font-weight:700;">${isIn ? '+' : '-'}${fmtMT(tx.quantity_mt)} MT</td>
