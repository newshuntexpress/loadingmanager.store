        return `<line x1="${cylX - 19}" y1="${y}" x2="${cylX - 14}" y2="${y}" stroke="#64748B" stroke-width="1.2" />
                <text x="${cylX - 22}" y="${y + 3}" text-anchor="end" font-size="9" fill="#64748B" font-family="IBM Plex Mono, monospace">${m}m</text>`;
