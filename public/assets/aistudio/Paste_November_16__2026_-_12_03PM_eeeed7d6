          <table>
            <thead><tr><th>Date</th><th>ID</th><th>Type</th><th>Tank</th><th>Material</th><th class="right">Qty (MT)</th><th class="right">Qty (KG)</th><th>Party</th></tr></thead>
            <tbody>
              ${filteredTxs.length === 0 ? `<tr><td colspan="8" class="c-muted" style="text-align:center;padding:24px;">No movements recorded.</td></tr>` : filteredTxs.map(tx => {
