            </linearGradient>
            <linearGradient id="liq-${uid}" x1="0" y1="0" x2="1" y2="0">
              <stop offset="0%" stop-color="#0369A1" /><stop offset="45%" stop-color="#38BDF8" /><stop offset="100%" stop-color="#075985" />
            </linearGradient>
            <clipPath id="clip-${uid}">
              <path d="M ${cylX} ${cylTopY} A ${rx} ${ry} 0 0 1 ${cylX + cylW} ${cylTopY} L ${cylX + cylW} ${cylBottomY} A ${rx} ${ry} 0 0 1 ${cylX} ${cylBottomY} Z" />
            </clipPath>
          </defs>
          <rect x="${cylX - 8}" y="${cylBottomY + 4}" width="${cylW + 16}" height="14" rx="3" fill="#475569" />
          <rect x="${cylX - 12}" y="${cylBottomY + 14}" width="${cylW + 24}" height="6" rx="2" fill="#334155" />
          <path d="M 16 ${cylTopY - 16} L 70 ${cylTopY - 16} L 70 ${cylTopY - 8}" fill="none" stroke="#16A34A" stroke-width="6" stroke-linecap="round" />
          <rect x="28" y="${cylTopY - 23}" width="12" height="14" rx="2" fill="#15803D" />
          <text x="16" y="${cylTopY - 29}" font-size="9" font-weight="600" fill="#16A34A" font-family="IBM Plex Mono, monospace">INWARD</text>
          <path d="M ${cylX + cylW - 4} ${cylBottomY - 12} L 244 ${cylBottomY - 12}" fill="none" stroke="#DC2626" stroke-width="6" stroke-linecap="round" />
          <circle cx="${cylX + cylW + 16}" cy="${cylBottomY - 12}" r="7" fill="#DC2626" stroke="#991B1B" stroke-width="2" />
          <text x="210" y="${cylBottomY - 22}" font-size="9" font-weight="600" fill="#DC2626" font-family="IBM Plex Mono, monospace">OUTWARD</text>
          <path d="M ${cylX - 5} ${cylTopY} L ${cylX - 5} ${cylBottomY} A ${rx + 5} ${ry + 2} 0 0 0 ${cylX + cylW + 5} ${cylBottomY} L ${cylX + cylW + 5} ${cylTopY} Z" fill="url(#shell-${uid})" stroke="#64748B" stroke-width="1.2" />
          <g clip-path="url(#clip-${uid})">
            <rect x="${cylX}" y="${cylTopY - ry}" width="${cylW}" height="${cylHeight + ry * 2}" fill="url(#empty-${uid})" />
            ${fillPct > 0 ? `<rect x="${cylX}" y="${liqTopY}" width="${cylW}" height="${liqH + ry + 4}" fill="url(#liq-${uid})" />
            <ellipse cx="${cx}" cy="${liqTopY}" rx="${rx}" ry="13" fill="#7DD3FC" stroke="#BAE6FD" stroke-width="1.2" />` : ''}
            <rect x="${cylX + 14}" y="${cylTopY - ry}" width="14" height="${cylHeight + ry * 2}" fill="#FFF" fill-opacity="0.2" />
          </g>
          <rect x="${cx - 72}" y="6" width="144" height="32" rx="5" fill="#0F172A" fill-opacity="0.92" stroke="#475569" stroke-width="1" />
          <text x="${cx}" y="19" text-anchor="middle" font-size="9.5" font-weight="700" fill="#F8FAFC" font-family="Plus Jakarta Sans, sans-serif">${esc(tank.name)}</text>
          <text x="${cx}" y="31" text-anchor="middle" font-size="8.5" font-weight="600" fill="#38BDF8" font-family="IBM Plex Mono, monospace">${esc(tank.productLabel.slice(0, 22))}</text>
          <path d="M ${cylX - 5} ${cylTopY} A ${rx + 5} ${ry + 16} 0 0 1 ${cylX + cylW + 5} ${cylTopY} A ${rx + 5} ${ry} 0 0 1 ${cylX - 5} ${cylTopY} Z" fill="#CBD5E1" stroke="#64748B" stroke-width="1.2" />
          <ellipse cx="${cx}" cy="${cylTopY - 12}" rx="18" ry="6" fill="#64748B" />
          <rect x="${cx - 4}" y="${cylTopY - 22}" width="8" height="10" rx="1" fill="#475569" />
          <line x1="${cylX - 14}" y1="${cylTopY}" x2="${cylX - 14}" y2="${cylBottomY}" stroke="#64748B" stroke-width="1.2" />
          ${ticks}
          <g transform="translate(0, ${pointerY})">
            <polygon points="${cylX + cylW + 7},0 ${cylX + cylW + 15},-5 ${cylX + cylW + 15},5" fill="#0284C7" />
            <rect x="${cylX + cylW + 16}" y="-12" width="52" height="24" rx="4" fill="#0F172A" />
            <text x="${cylX + cylW + 42}" y="3" text-anchor="middle" font-size="10" font-weight="700" fill="#38BDF8" font-family="IBM Plex Mono, monospace">${fillPct.toFixed(1)}%</text>
          </g>
        </svg>`;
    }

