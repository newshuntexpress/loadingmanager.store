          <table>
            <thead>
              <tr><th>Tank Name</th><th>Location</th><th class="right">Capacity (MT)</th><th class="right">Capacity (KG)</th><th class="right">Depth</th><th class="right">Stock (MT)</th><th class="right">Empty (MT)</th><th class="right">Filled / Empty</th><th>Last Transaction</th><th class="right no-print">Actions</th></tr>
