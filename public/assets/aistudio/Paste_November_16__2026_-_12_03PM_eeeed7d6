    }

    function renderRegister(mode) {
      const q = regFilters.search.trim().toLowerCase();
      const rows = state.transactions
        .filter(tx => {
          if (mode === 'INWARD' && tx.type !== 'INWARD') return false;
          if (mode === 'OUTWARD' && tx.type !== 'OUTWARD') return false;
          if (mode === 'HISTORY' && regFilters.type !== 'ALL' && tx.type !== regFilters.type) return false;
          if (regFilters.tankId !== 'ALL' && String(tx.tank_id) !== regFilters.tankId) return false;
          if (regFilters.material !== 'ALL' && tx.material_name !== regFilters.material) return false;
          const d = tx.tx_date.slice(0, 10);
          if (regFilters.start && d < regFilters.start) return false;
          if (regFilters.end && d > regFilters.end) return false;
          if (q) {
            const tankName = state.tanks.find(t => t.id === tx.tank_id)?.name || '';
            const hay = `${tx.tx_code} ${tankName} ${tx.material_name} ${tx.reference_number} ${tx.party_name} ${tx.vehicle_number} ${tx.remarks}`.toLowerCase();
            if (!hay.includes(q)) return false;
          }
          return true;
        })
        .sort((a, b) => b.tx_date.localeCompare(a.tx_date) || b.id - a.id);

      const title = mode === 'INWARD' ? 'Material Inward Register' : mode === 'OUTWARD' ? 'Material Outward Register' : 'Transaction History & Audit Trail';
      return `
        <div style="display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;">
          <div><h2>${title}</h2></div>
          <div style="display:flex;gap:8px;flex-wrap:wrap;" class="no-print">
            ${mode !== 'OUTWARD' ? `<button class="btn btn-green" onclick="openTxModal('INWARD')">+ Add Inward</button>` : ''}
            ${mode !== 'INWARD' ? `<button class="btn btn-red" onclick="openTxModal('OUTWARD')">- Add Outward</button>` : ''}
            <button class="btn" onclick="exportRegisterCSV('${mode}')">Export Excel (CSV)</button>
            <button class="btn" onclick="window.print()">Download PDF / Print</button>
          </div>
        </div>

        ${mode === 'HISTORY' ? `
          <div class="seg-bar no-print">
            <button class="seg-btn ${historySubTab === 'ledger' ? 'active' : ''}" onclick="historySubTab='ledger';render();">Transaction Ledger (${rows.length})</button>
            <button class="seg-btn ${historySubTab === 'audit' ? 'active' : ''}" onclick="historySubTab='audit';render();">Audit Log (${state.auditLogs.length})</button>
          </div>` : ''}

        ${mode === 'HISTORY' && historySubTab === 'audit' ? `
          <div class="table-wrap">
            <table>
              <thead><tr><th>Timestamp</th><th>Action</th><th>Entity</th><th>Summary</th><th>Performed By</th></tr></thead>
              <tbody>${state.auditLogs.map(a => `<tr>
                <td class="mono c-muted">${fmtDate(a.created_at)}</td>
                <td class="mono"><strong>${esc(a.action)}</strong></td>
                <td>${esc(a.entity_type)}</td>
                <td>${esc(a.summary)}</td>
                <td>${esc(a.performed_by)}</td>
              </tr>`).join('')}</tbody>
            </table>
          </div>` : `
          <div class="card no-print" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:10px;">
            <input type="text" placeholder="Search ID, ref, party, vehicle..." value="${esc(regFilters.search)}" oninput="regFilters.search=this.value;render();" />
            ${mode === 'HISTORY' ? `<select onchange="regFilters.type=this.value;render();"><option value="ALL">All Types</option><option value="INWARD" ${regFilters.type==='INWARD'?'selected':''}>Inward</option><option value="OUTWARD" ${regFilters.type==='OUTWARD'?'selected':''}>Outward</option></select>` : ''}
            <select onchange="regFilters.tankId=this.value;render();">
              <option value="ALL">All Tanks</option>
              ${state.tanks.map(t => `<option value="${t.id}" ${regFilters.tankId===String(t.id)?'selected':''}>${esc(t.name)}</option>`).join('')}
            </select>
            <select onchange="regFilters.material=this.value;render();">
              <option value="ALL">All Materials</option>
              ${state.materials.map(m => `<option value="${esc(m.name)}" ${regFilters.material===m.name?'selected':''}>${esc(m.name)}</option>`).join('')}
            </select>
            <input type="date" value="${regFilters.start}" onchange="regFilters.start=this.value;render();" />
            <input type="date" value="${regFilters.end}" onchange="regFilters.end=this.value;render();" />
          </div>
          <div class="table-wrap">
            <table>
              <thead><tr><th>Date</th><th>Transaction ID</th><th>Type</th><th>Tank</th><th>Material</th><th class="right">Qty (KG)</th><th class="right">Qty (MT)</th><th>Ref No.</th><th>Supplier / Customer</th><th>Vehicle</th><th>Remarks</th><th class="right no-print">Action</th></tr></thead>
              <tbody>
                ${rows.length === 0 ? `<tr><td colspan="12" class="c-muted" style="text-align:center;padding:26px;">No matching transactions.</td></tr>` : rows.map(tx => {
                  const isIn = tx.type === 'INWARD';
                  const tankName = state.tanks.find(t => t.id === tx.tank_id)?.name || '-';
                  return `<tr>
                    <td class="mono">${fmtDate(tx.tx_date)}</td>
                    <td class="mono"><strong>${esc(tx.tx_code)}</strong></td>
                    <td class="${isIn ? 'c-green' : 'c-red'}" style="font-weight:700;">${tx.type}</td>
                    <td>${esc(tankName)}</td>
                    <td>${esc(tx.material_name)}</td>
                    <td class="right mono ${isIn ? 'c-green' : 'c-red'}"><strong>${isIn ? '+' : '-'}${fmtKG(tx.quantity_kg)}</strong></td>
                    <td class="right mono ${isIn ? 'c-green' : 'c-red'}"><strong>${isIn ? '+' : '-'}${fmtMT(tx.quantity_mt)} MT</strong></td>
                    <td class="mono">${esc(tx.reference_number || '-')}</td>
                    <td>${esc(tx.party_name || '-')}</td>
                    <td class="mono">${esc(tx.vehicle_number || '-')}</td>
                    <td>${esc(tx.remarks || '-')}</td>
                    <td class="right no-print">
                      <button class="btn" onclick="openTxModal('${tx.type}', null, ${tx.id})">Edit</button>
                      <button class="btn btn-red" onclick="deleteTransaction(${tx.id})">Delete</button>
                    </td>
                  </tr>`;
                }).join('')}
              </tbody>
            </table>
          </div>`}`;
    }

    function renderReports() {
      const txs = state.transactions.filter(tx => {
        if (repFilters.tankId !== 'ALL' && String(tx.tank_id) !== repFilters.tankId) return false;
        if (repFilters.material !== 'ALL' && tx.material_name !== repFilters.material) return false;
        const d = tx.tx_date.slice(0, 10);
        if (repFilters.start && d < repFilters.start) return false;
        if (repFilters.end && d > repFilters.end) return false;
        return true;
      });
      const matNames = repFilters.material === 'ALL' ? state.materials.map(m => m.name) : [repFilters.material];
      const summaryRows = matNames.map(name => {
        const list = txs.filter(t => t.material_name === name);
        const inKg = list.filter(t => t.type === 'INWARD').reduce((a, b) => a + b.quantity_kg, 0);
        const outKg = list.filter(t => t.type === 'OUTWARD').reduce((a, b) => a + b.quantity_kg, 0);
        return { name, inKg, outKg, balKg: inKg - outKg };
      });
      return `
        <div style="display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;">
          <div><h2>Material-Wise Stock Report</h2><p class="c-muted" style="font-size:13px;margin:4px 0 0;">Consolidated inward, outward, and current balance in KG & MT</p></div>
          <div style="display:flex;gap:8px;" class="no-print">
            <button class="btn" onclick="window.print()">Download PDF / Print</button>
          </div>
        </div>
        <div class="card no-print" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:10px;">
          <select onchange="repFilters.tankId=this.value;render();">
            <option value="ALL">All Tanks</option>
            ${state.tanks.map(t => `<option value="${t.id}" ${repFilters.tankId===String(t.id)?'selected':''}>${esc(t.name)}</option>`).join('')}
          </select>
          <select onchange="repFilters.material=this.value;render();">
            <option value="ALL">All Materials</option>
            ${state.materials.map(m => `<option value="${esc(m.name)}" ${repFilters.material===m.name?'selected':''}>${esc(m.name)}</option>`).join('')}
          </select>
          <input type="date" value="${repFilters.start}" onchange="repFilters.start=this.value;render();" />
          <input type="date" value="${repFilters.end}" onchange="repFilters.end=this.value;render();" />
        </div>
        <div class="table-wrap">
          <table>
            <thead><tr><th>Material Name</th><th class="right">Total Inward (KG)</th><th class="right">Total Inward (MT)</th><th class="right">Total Outward (KG)</th><th class="right">Total Outward (MT)</th><th class="right">Current Balance (KG)</th><th class="right">Current Balance (MT)</th></tr></thead>
            <tbody>
              ${summaryRows.map(r => `<tr>
                <td><strong>${esc(r.name)}</strong></td>
                <td class="right mono c-green">${fmtKG(r.inKg)} KG</td>
                <td class="right mono c-green"><strong>${fmtMT(r.inKg / 1000)} MT</strong></td>
                <td class="right mono c-red">${fmtKG(r.outKg)} KG</td>
                <td class="right mono c-red"><strong>${fmtMT(r.outKg / 1000)} MT</strong></td>
                <td class="right mono">${fmtKG(r.balKg)} KG</td>
                <td class="right mono c-blue"><strong>${fmtMT(r.balKg / 1000)} MT</strong></td>
              </tr>`).join('')}
            </tbody>
          </table>
        </div>`;
    }

    function renderSettings() {
      return `
        <div style="max-width:860px;display:flex;flex-direction:column;gap:20px;">
          <h2>System Settings & Material Master Data</h2>
          <form class="card" onsubmit="saveSettingsForm(event)" style="display:flex;flex-direction:column;gap:14px;">
            <div style="display:flex;justify-content:space-between;align-items:center;">
              <h3>Operator & Facility Configuration</h3>
              <div class="seg-bar">
                <button type="button" class="seg-btn ${state.settings.theme==='light'?'active':''}" onclick="setTheme('light')">Light</button>
                <button type="button" class="seg-btn ${state.settings.theme==='dark'?'active':''}" onclick="setTheme('dark')">Dark</button>
              </div>
            </div>
            <div class="form-grid-2">
              <div><label>Operator Name *</label><input id="set-name" value="${esc(state.settings.full_name)}" required /></div>
              <div><label>Email *</label><input id="set-email" type="email" value="${esc(state.settings.email)}" required /></div>
              <div><label>Role</label><input id="set-role" value="${esc(state.settings.role)}" /></div>
              <div><label>Facility Name</label><input id="set-facility" value="${esc(state.settings.facility_name)}" /></div>
            </div>
            <div style="display:flex;justify-content:space-between;align-items:center;">
              <button type="button" class="btn btn-red" onclick="resetDemoData()">Reset Default Data</button>
              <button type="submit" class="btn btn-dark">Save Settings</button>
            </div>
          </form>

          <div class="card" style="display:flex;flex-direction:column;gap:14px;">
            <h3>Material Master Data (Create / Edit / Delete)</h3>
            <div class="table-wrap">
              <table>
                <thead><tr><th>Material Name</th><th>Code</th><th>Description</th><th class="right">Actions</th></tr></thead>
                <tbody>
                  ${state.materials.map(m => editingMatId === m.id ? `
                    <tr>
                      <td><input id="edit-mat-name" value="${esc(m.name)}" style="text-transform:uppercase;" /></td>
                      <td><input id="edit-mat-code" value="${esc(m.code)}" style="text-transform:uppercase;" /></td>
                      <td><input id="edit-mat-desc" value="${esc(m.description)}" /></td>
                      <td class="right">
                        <button type="button" class="btn btn-blue" onclick="saveMaterialEdit(${m.id})">Save</button>
                        <button type="button" class="btn" onclick="editingMatId=null;render();">Cancel</button>
                      </td>
                    </tr>` : `
                    <tr>
                      <td><strong>${esc(m.name)}</strong></td>
                      <td class="mono">${esc(m.code)}</td>
                      <td class="c-muted">${esc(m.description || '-')}</td>
                      <td class="right">
                        <button type="button" class="btn" onclick="editingMatId=${m.id};render();">Edit</button>
                        <button type="button" class="btn btn-red" onclick="deleteMaterial(${m.id})">Delete</button>
                      </td>
                    </tr>`).join('')}
                </tbody>
              </table>
            </div>
            <form onsubmit="addMaterialForm(event)" style="display:grid;grid-template-columns:2fr 1fr 2fr auto;gap:8px;">
              <input id="new-mat-name" placeholder="Material Name (e.g. FURNACE OIL)" style="text-transform:uppercase;" required />
              <input id="new-mat-code" placeholder="Code" style="text-transform:uppercase;" />
              <input id="new-mat-desc" placeholder="Description (optional)" />
              <button type="submit" class="btn btn-dark">+ Add Material</button>
            </form>
          </div>
        </div>`;
    }

    function render() {
      document.documentElement.classList.toggle('dark', state.settings.theme === 'dark');
      document.getElementById('brand-facility').textContent = state.settings.facility_name;
      document.getElementById('sidebar-operator').textContent = state.settings.full_name;
      document.getElementById('sidebar-role').textContent = state.settings.role;

      const titles = {
        dashboard: 'Dashboard', tanks: 'Tank Management', inward: 'Material Inward',
        outward: 'Material Outward', history: 'Transaction History', reports: 'Stock Reports', settings: 'Settings'
      };
      document.getElementById('page-title').textContent = titles[activeNav];
      document.querySelectorAll('.nav-btn').forEach(btn => btn.classList.toggle('active', btn.dataset.nav === activeNav));

      const main = document.getElementById('app-content');
      if (activeNav === 'dashboard') main.innerHTML = renderDashboard();
      else if (activeNav === 'tanks') main.innerHTML = renderTankManagement();
      else if (activeNav === 'inward') main.innerHTML = renderRegister('INWARD');
      else if (activeNav === 'outward') main.innerHTML = renderRegister('OUTWARD');
      else if (activeNav === 'history') main.innerHTML = renderRegister('HISTORY');
      else if (activeNav === 'reports') main.innerHTML = renderReports();
      else if (activeNav === 'settings') main.innerHTML = renderSettings();
    }

    // Navigation
    document.querySelectorAll('.nav-btn').forEach(btn => {
      btn.addEventListener('click', () => switchNav(btn.dataset.nav));
    });
    function switchNav(nav) {
      activeNav = nav;
      document.getElementById('sidebar').classList.remove('open');
      render();
    }
    function toggleMobileSidebar() {
      document.getElementById('sidebar').classList.toggle('open');
    }
    function setDashFilter(f) { dashMaterialFilter = f; render(); }
    function setDashMode(m) { dashViewMode = m; render(); }

    // Transaction Modal Actions
    function openTxModal(type, tankId = null, editId = null) {
      if (state.tanks.length === 0) { showToast('error', 'Please create a tank first.'); return; }
      txModalState = { mode: editId ? 'edit' : 'create', type, editId, confirmStep: false };
      setTxConfirmStep(false);
      document.getElementById('tx-error').style.display = 'none';

      const tankSel = document.getElementById('tx-tank');
      tankSel.innerHTML = state.tanks.map(t => {
        const st = computeTank(t);
        return `<option value="${t.id}">${esc(t.name)} — ${esc(st.productLabel)} (${fmtMT(st.current_stock_mt)} / ${fmtMT(st.total_capacity_mt)} MT)</option>`;
      }).join('');

      const matSel = document.getElementById('tx-material');
      matSel.innerHTML = state.materials.map(m => `<option value="${esc(m.name)}">${esc(m.name)}</option>`).join('');

      if (editId) {
        const tx = state.transactions.find(t => t.id === editId);
        txModalState.type = tx.type;
        document.getElementById('tx-date').value = tx.tx_date.slice(0, 16);
        tankSel.value = String(tx.tank_id);
        matSel.value = tx.material_name;
        document.getElementById('tx-qty').value = tx.quantity_kg;
        document.getElementById('tx-ref').value = tx.reference_number;
        document.getElementById('tx-party').value = tx.party_name;
        document.getElementById('tx-vehicle').value = tx.vehicle_number;
        document.getElementById('tx-remarks').value = tx.remarks;
      } else {
        document.getElementById('tx-date').value = nowLocalInput();
        tankSel.value = String(tankId || state.tanks[0].id);
        document.getElementById('tx-qty').value = '';
        document.getElementById('tx-ref').value = '';
        document.getElementById('tx-party').value = '';
        document.getElementById('tx-vehicle').value = '';
        document.getElementById('tx-remarks').value = '';
      }

      const isIn = txModalState.type === 'INWARD';
      document.getElementById('tx-modal-title').textContent = `${editId ? 'Edit' : 'Add'} Material ${isIn ? 'Inward' : 'Outward'} Entry`;
      document.getElementById('tx-party-label').textContent = isIn ? 'Supplier Name *' : 'Customer / Department *';
      updateTxPreview();
      document.getElementById('tx-modal-backdrop').classList.add('open');
    }

    function closeTxModal() { document.getElementById('tx-modal-backdrop').classList.remove('open'); }

    function setTxConfirmStep(confirm) {
      txModalState.confirmStep = confirm;
      document.getElementById('tx-step-edit').style.display = confirm ? 'none' : 'block';
      document.getElementById('tx-step-confirm').style.display = confirm ? 'block' : 'none';
      document.getElementById('tx-back-btn').style.display = confirm ? 'inline-flex' : 'none';
      const btn = document.getElementById('tx-submit-btn');
      btn.className = `btn ${txModalState.type === 'INWARD' ? 'btn-green' : 'btn-red'}`;
      btn.textContent = confirm ? `Confirm & Save ${txModalState.type}` : 'Review & Confirm';
    }

    function updateTxPreview() {
      const tankId = Number(document.getElementById('tx-tank').value);
      const qty = Number(document.getElementById('tx-qty').value) || 0;
      const mat = document.getElementById('tx-material').value;
      document.getElementById('tx-mt-preview').textContent = `= ${fmtMT(qty / 1000)} MT`;
      const tank = state.tanks.find(t => t.id === tankId);
      if (!tank) return;
      const st = computeTank(tank);
      const matBal = st.materials.find(m => m.material_name === mat)?.balance_kg || 0;
      document.getElementById('tx-tank-info').innerHTML = `
        Current Stock: <strong>${fmtMT(st.current_stock_mt)} MT</strong> (${fmtKG(st.current_stock_kg)} KG) ·
        Empty Capacity: <strong>${fmtMT(st.empty_capacity_mt)} MT</strong> ·
        ${esc(mat)}: <strong>${fmtMT(matBal / 1000)} MT</strong>`;
    }

    function handleTxFormSubmit(e) {
      e.preventDefault();
      const errBox = document.getElementById('tx-error');
      errBox.style.display = 'none';

      const payload = {
        type: txModalState.type,
        tx_date: document.getElementById('tx-date').value,
        tank_id: Number(document.getElementById('tx-tank').value),
        material_name: document.getElementById('tx-material').value,
        quantity_kg: Number(document.getElementById('tx-qty').value),
        quantity_mt: Number(document.getElementById('tx-qty').value) / 1000,
        reference_number: document.getElementById('tx-ref').value.trim(),
        party_name: document.getElementById('tx-party').value.trim(),
        vehicle_number: document.getElementById('tx-vehicle').value.trim().toUpperCase(),
        remarks: document.getElementById('tx-remarks').value.trim()
      };

      if (!(payload.quantity_kg > 0)) {
        errBox.textContent = 'Quantity (KG) must be greater than 0.';
        errBox.style.display = 'block';
        return;
      }

      const nextList = txModalState.editId
        ? state.transactions.map(t => t.id === txModalState.editId ? { ...t, ...payload } : t)
        : [...state.transactions, { ...payload, id: state.nextTxId, tx_code: 'PREVIEW', created_at: new Date().toISOString() }];

      const err = validateAllTanks(nextList);
      if (err) {
        errBox.textContent = err;
        errBox.style.display = 'block';
        setTxConfirmStep(false);
        return;
      }

      const tank = state.tanks.find(t => t.id === payload.tank_id);
      const proj = computeTank(tank, nextList);

      if (!txModalState.confirmStep) {
        document.getElementById('tx-confirm-summary').innerHTML = `
          <div><span class="c-muted">Tank:</span><br><strong>${esc(tank.name)}</strong></div>
          <div><span class="c-muted">Material:</span><br><strong>${esc(payload.material_name)}</strong></div>
          <div><span class="c-muted">Quantity:</span><br><strong class="mono">${fmtKG(payload.quantity_kg)} KG (${fmtMT(payload.quantity_mt)} MT)</strong></div>
          <div><span class="c-muted">Projected Level:</span><br><strong class="mono c-blue">${fmtMT(proj.current_stock_mt)} MT (${fmtPct(proj.filled_percentage)})</strong></div>`;
        setTxConfirmStep(true);
        return;
      }

      if (txModalState.editId) {
        state.transactions = nextList;
        const edited = state.transactions.find(t => t.id === txModalState.editId);
        addAudit('UPDATE', 'TRANSACTION', `Updated ${edited.tx_code}: ${fmtKG(payload.quantity_kg)} KG ${payload.material_name} in ${tank.name}`);
        showToast('success', `Updated ${edited.tx_code} and recalculated stock.`);
      } else {
        const prefix = payload.type === 'INWARD' ? 'INW' : 'OUT';
        const code = `${prefix}-${payload.tx_date.slice(0, 10).replaceAll('-', '')}-${String(state.nextTxId).padStart(4, '0')}`;
        state.transactions.push({ ...payload, id: state.nextTxId++, tx_code: code, created_at: new Date().toISOString() });
        addAudit('CREATE', 'TRANSACTION', `${payload.type} ${code}: ${fmtKG(payload.quantity_kg)} KG ${payload.material_name} (${tank.name})`);
        showToast('success', `Saved ${code} (${fmtMT(payload.quantity_mt)} MT).`);
      }

      saveState();
      closeTxModal();
      render();
    }

    function deleteTransaction(id) {
      const tx = state.transactions.find(t => t.id === id);
      if (!tx || !confirm(`Delete transaction ${tx.tx_code} (${fmtKG(tx.quantity_kg)} KG)?`)) return;
      const nextList = state.transactions.filter(t => t.id !== id);
      const err = validateAllTanks(nextList);
      if (err) { showToast('error', err); return; }
      state.transactions = nextList;
      addAudit('DELETE', 'TRANSACTION', `Deleted ${tx.type} ${tx.tx_code} (${fmtKG(tx.quantity_kg)} KG ${tx.material_name})`);
      saveState();
      render();
      showToast('success', `Deleted ${tx.tx_code} and recalculated tank stock.`);
    }

    // Tank Modal Actions
    function openTankModal(editId = null) {
      tankModalEditId = editId;
      document.getElementById('tank-error').style.display = 'none';
      if (editId) {
        const t = state.tanks.find(x => x.id === editId);
        document.getElementById('tank-modal-title').textContent = `Edit ${t.name}`;
        document.getElementById('tank-name').value = t.name;
        document.getElementById('tank-cap').value = t.total_capacity_kg;
        document.getElementById('tank-mt-preview').textContent = `= ${fmtMT(t.total_capacity_kg / 1000)} MT`;
        document.getElementById('tank-depth').value = t.depth_meters;
        document.getElementById('tank-loc').value = t.location;
        document.getElementById('tank-notes').value = t.notes;
      } else {
        document.getElementById('tank-modal-title').textContent = 'Add New Tank';
        document.getElementById('tank-name').value = '';
        document.getElementById('tank-cap').value = '2000000';
        document.getElementById('tank-mt-preview').textContent = '= 2,000 MT';
        document.getElementById('tank-depth').value = '7';
        document.getElementById('tank-loc').value = 'Main Storage Bay A';
        document.getElementById('tank-notes').value = '';
      }
      document.getElementById('tank-modal-backdrop').classList.add('open');
    }
    function closeTankModal() { document.getElementById('tank-modal-backdrop').classList.remove('open'); }

    function handleTankFormSubmit(e) {
      e.preventDefault();
      const errBox = document.getElementById('tank-error');
      const name = document.getElementById('tank-name').value.trim();
      const cap = Number(document.getElementById('tank-cap').value);
      const depth = Number(document.getElementById('tank-depth').value);
      const loc = document.getElementById('tank-loc').value.trim() || 'Main Storage Bay';
      const notes = document.getElementById('tank-notes').value.trim();

      if (state.tanks.some(t => t.name.toLowerCase() === name.toLowerCase() && t.id !== tankModalEditId)) {
        errBox.textContent = `Tank "${name}" already exists.`;
        errBox.style.display = 'block';
        return;
      }
      if (tankModalEditId) {
        const current = computeTank(state.tanks.find(t => t.id === tankModalEditId));
        if (cap < current.current_stock_kg - 0.0001) {
          errBox.textContent = `Capacity cannot be less than current stock (${fmtKG(current.current_stock_kg)} KG).`;
          errBox.style.display = 'block';
          return;
        }
        state.tanks = state.tanks.map(t => t.id === tankModalEditId ? { ...t, name, total_capacity_kg: cap, depth_meters: depth, location: loc, notes } : t);
        addAudit('TANK_UPDATE', 'TANK', `Updated ${name} (${fmtMT(cap / 1000)} MT, ${depth}m)`);
        showToast('success', `Updated ${name}.`);
      } else {
        state.tanks.push({ id: state.nextTankId++, name, total_capacity_kg: cap, depth_meters: depth, location: loc, notes });
        addAudit('TANK_CREATE', 'TANK', `Created ${name} (${fmtMT(cap / 1000)} MT, ${depth}m)`);
        showToast('success', `Created new tank ${name}.`);
      }
      saveState();
      closeTankModal();
      render();
    }

    function deleteTank(id) {
      const tank = computeTank(state.tanks.find(t => t.id === id));
      if (tank.current_stock_kg > 0) { showToast('error', `Cannot delete ${tank.name} while it holds stock.`); return; }
      if (state.transactions.some(tx => tx.tank_id === id)) { showToast('error', `Cannot delete ${tank.name} because register transactions reference it.`); return; }
      if (!confirm(`Delete ${tank.name} permanently?`)) return;
      state.tanks = state.tanks.filter(t => t.id !== id);
      addAudit('TANK_DELETE', 'TANK', `Deleted ${tank.name}`);
      saveState();
      render();
      showToast('success', `Deleted ${tank.name}.`);
    }

    function openDetailModal(id) {
      const t = computeTank(state.tanks.find(x => x.id === id));
      document.getElementById('detail-title').textContent = `${t.name} — ${t.productLabel}`;
      document.getElementById('detail-sub').textContent = `${t.location} · Specifications`;
      document.getElementById('detail-body').innerHTML = `
        <div class="form-grid-2" style="font-size:13px;">
          <div class="metric-box"><div class="c-muted" style="font-size:11px;">Total Capacity</div><strong class="mono">${fmtMT(t.total_capacity_mt)} MT (${fmtKG(t.total_capacity_kg)} KG)</strong></div>
          <div class="metric-box"><div class="c-muted" style="font-size:11px;">Tank Depth</div><strong class="mono">${fmtM(t.depth_meters)} Meters</strong></div>
          <div class="metric-box"><div class="c-muted" style="font-size:11px;">Current Stock</div><strong class="mono c-blue">${fmtMT(t.current_stock_mt)} MT (${fmtKG(t.current_stock_kg)} KG)</strong></div>
          <div class="metric-box"><div class="c-muted" style="font-size:11px;">Empty Capacity</div><strong class="mono">${fmtMT(t.empty_capacity_mt)} MT (${fmtKG(t.empty_capacity_kg)} KG)</strong></div>
          <div class="metric-box"><div class="c-muted" style="font-size:11px;">Filled / Empty (%)</div><strong class="mono">${fmtPct(t.filled_percentage)} / ${fmtPct(t.empty_percentage)}</strong></div>
          <div class="metric-box"><div class="c-muted" style="font-size:11px;">Filled / Empty (m)</div><strong class="mono">${fmtM(t.filled_meters)} m / ${fmtM(t.empty_meters)} m</strong></div>
        </div>
        <div style="font-size:12px;" class="c-muted">Last Transaction: ${fmtDate(t.last_transaction_at)}</div>`;
      document.getElementById('tank-detail-backdrop').classList.add('open');
    }
    function closeDetailModal() { document.getElementById('tank-detail-backdrop').classList.remove('open'); }

    // Settings & Material CRUD
    function setTheme(theme) { state.settings.theme = theme; saveState(); render(); }
    function saveSettingsForm(e) {
      e.preventDefault();
      state.settings.full_name = document.getElementById('set-name').value.trim();
      state.settings.email = document.getElementById('set-email').value.trim();
      state.settings.role = document.getElementById('set-role').value.trim();
      state.settings.facility_name = document.getElementById('set-facility').value.trim();
      saveState();
      render();
      showToast('success', 'Settings saved.');
    }

    function addMaterialForm(e) {
      e.preventDefault();
      const name = document.getElementById('new-mat-name').value.trim().toUpperCase();
      const code = document.getElementById('new-mat-code').value.trim().toUpperCase() || name.slice(0, 8);
      const desc = document.getElementById('new-mat-desc').value.trim();
      if (state.materials.some(m => m.name.toLowerCase() === name.toLowerCase())) { showToast('error', `Material "${name}" already exists.`); return; }
      state.materials.push({ id: state.nextMatId++, name, code, description: desc });
      addAudit('CREATE', 'MATERIAL', `Added material ${name} (${code})`);
      saveState();
      render();
      showToast('success', `Added material ${name}.`);
    }

    function saveMaterialEdit(id) {
      const name = document.getElementById('edit-mat-name').value.trim().toUpperCase();
      const code = document.getElementById('edit-mat-code').value.trim().toUpperCase() || name.slice(0, 8);
      const description = document.getElementById('edit-mat-desc').value.trim();
      if (!name) return;
      if (state.materials.some(m => m.name.toLowerCase() === name.toLowerCase() && m.id !== id)) { showToast('error', `Material "${name}" already exists.`); return; }
      const old = state.materials.find(m => m.id === id);
      if (old.name !== name) {
        state.transactions = state.transactions.map(t => t.material_name === old.name ? { ...t, material_name: name } : t);
      }
      state.materials = state.materials.map(m => m.id === id ? { ...m, name, code, description } : m);
      addAudit('UPDATE', 'MATERIAL', `Updated material ${old.name} -> ${name}`);
      editingMatId = null;
      saveState();
      render();
      showToast('success', `Updated material ${name}.`);
    }

    function deleteMaterial(id) {
      const mat = state.materials.find(m => m.id === id);
      const used = state.transactions.filter(t => t.material_name === mat.name).length;
      if (used > 0) { showToast('error', `Cannot delete "${mat.name}" because ${used} transaction(s) reference it.`); return; }
      if (!confirm(`Delete material "${mat.name}" permanently?`)) return;
      state.materials = state.materials.filter(m => m.id !== id);
      addAudit('DELETE', 'MATERIAL', `Deleted material ${mat.name}`);
      saveState();
      render();
      showToast('success', `Deleted material ${mat.name}.`);
    }

    function exportRegisterCSV(mode) {
      const rows = state.transactions.filter(tx => mode === 'HISTORY' ? true : tx.type === mode);
      const header = ['Date', 'Transaction ID', 'Type', 'Tank', 'Material', 'Qty (KG)', 'Qty (MT)', 'Reference', 'Party', 'Vehicle', 'Remarks'];
      const lines = [header.join(','), ...rows.map(r => {
        const tn = state.tanks.find(t => t.id === r.tank_id)?.name || '';
        return [r.tx_date, r.tx_code, r.type, tn, r.material_name, r.quantity_kg, r.quantity_mt, r.reference_number, r.party_name, r.vehicle_number, r.remarks]
          .map(v => `"${String(v ?? '').replaceAll('"', '""')}"`).join(',');
      })];
      const blob = new Blob([lines.join('\n')], { type: 'text/csv;charset=utf-8;' });
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = `${mode.toLowerCase()}_register.csv`;
      a.click();
    }

    function resetDemoData() {
      if (!confirm('Reset all tanks, transactions, and settings back to initial defaults?')) return;
      state = createSeedState();
      saveState();
      render();
      showToast('success', 'Reset to default inventory data.');
    }

    render();
  </script>
</body>
</html>