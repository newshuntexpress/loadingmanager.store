                <td class="mono c-muted">${fmtDate(t.last_transaction_at)}</td>
                <td class="right no-print">
                  <button class="btn" onclick="openDetailModal(${t.id})">Details</button>
                  <button class="btn" onclick="openTankModal(${t.id})">Edit</button>
