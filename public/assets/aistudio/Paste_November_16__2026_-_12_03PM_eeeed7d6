    function renderDashboard() {
      const tanks = state.tanks.map(t => computeTank(t));
      const today = todayPrefix();
      const matNames = Array.from(new Set([...state.materials.map(m => m.name), ...state.transactions.map(t => t.material_name)]));

      const matStats = matNames.map(name => {
        let inKg = 0, outKg = 0, todayIn = 0, todayOut = 0;
        for (const tx of state.transactions) {
          if (tx.material_name !== name) continue;
          const isToday = tx.tx_date.slice(0, 10) === today;
          if (tx.type === 'INWARD') { inKg += tx.quantity_kg; if (isToday) todayIn += tx.quantity_kg; }
          else { outKg += tx.quantity_kg; if (isToday) todayOut += tx.quantity_kg; }
        }
        const activeTanks = tanks.filter(t => t.materials.some(m => m.material_name === name && m.balance_kg > 0.0001));
        const allocCap = activeTanks.reduce((a, t) => a + t.total_capacity_kg, 0);
        const bal = inKg - outKg;
        return {
          name, inKg, outKg, todayIn, todayOut, bal,
          allocCap, emptyCap: Math.max(0, allocCap - bal), tanks: activeTanks
        };
      });

      const emptyTanks = tanks.filter(t => t.current_stock_kg <= 0.0001);

      let kpi = {
        cap: tanks.reduce((a, t) => a + t.total_capacity_kg, 0),
        stock: tanks.reduce((a, t) => a + t.current_stock_kg, 0),
        empty: tanks.reduce((a, t) => a + t.empty_capacity_kg, 0),
        inToday: state.transactions.filter(t => t.type === 'INWARD' && t.tx_date.slice(0, 10) === today).reduce((a, t) => a + t.quantity_kg, 0),
        outToday: state.transactions.filter(t => t.type === 'OUTWARD' && t.tx_date.slice(0, 10) === today).reduce((a, t) => a + t.quantity_kg, 0),
        count: tanks.length
      };

      if (dashMaterialFilter === 'EMPTY') {
        const cap = emptyTanks.reduce((a, t) => a + t.total_capacity_kg, 0);
        kpi = { cap, stock: 0, empty: cap, inToday: 0, outToday: 0, count: emptyTanks.length };
      } else if (dashMaterialFilter !== 'ALL') {
        const s = matStats.find(m => m.name === dashMaterialFilter);
        if (s) {
          kpi = { cap: s.allocCap, stock: s.bal, empty: s.emptyCap, inToday: s.todayIn, outToday: s.todayOut, count: s.tanks.length };
        }
      }

      const filteredTxs = state.transactions
        .filter(tx => dashMaterialFilter === 'ALL' ? true : dashMaterialFilter === 'EMPTY' ? false : tx.material_name === dashMaterialFilter)
        .slice()
        .sort((a, b) => b.tx_date.localeCompare(a.tx_date) || b.id - a.id)
        .slice(0, 10);

      let tanksHtml = '';
      if (dashViewMode === 'by-material' && dashMaterialFilter === 'ALL') {
        tanksHtml = matStats.map(g => `
          <div style="display:flex;flex-direction:column;gap:12px;">
            <div style="display:flex;justify-content:space-between;align-items:baseline;border-bottom:1px solid var(--border);padding-bottom:6px;">
              <div><strong>${esc(g.name)}</strong> <span class="mono c-muted" style="font-size:12px;">(${g.tanks.length} ${g.tanks.length === 1 ? 'Tank' : 'Tanks'})</span></div>
              <div class="mono c-blue" style="font-size:12px;font-weight:600;">Stock: ${fmtMT(g.bal / 1000)} MT (${fmtKG(g.bal)} KG)</div>
            </div>
            ${g.tanks.length === 0
              ? `<div class="card c-muted" style="text-align:center;font-size:12px;">No tanks currently hold ${esc(g.name)}.</div>`
              : `<div class="tank-grid ${g.tanks.length === 1 ? 'single' : ''}">${g.tanks.map(renderTankCard).join('')}</div>`}
          </div>`).join('') + `
          <div style="display:flex;flex-direction:column;gap:12px;">
            <div style="display:flex;justify-content:space-between;align-items:baseline;border-bottom:1px solid var(--border);padding-bottom:6px;">
              <div><strong>Empty / Standby Tanks</strong> <span class="mono c-muted" style="font-size:12px;">(${emptyTanks.length} Tanks)</span></div>
              <div class="mono c-muted" style="font-size:12px;">Available: ${fmtMT(emptyTanks.reduce((a, t) => a + t.empty_capacity_mt, 0))} MT</div>
            </div>
            <div class="tank-grid ${emptyTanks.length === 1 ? 'single' : ''}">${emptyTanks.map(renderTankCard).join('')}</div>
          </div>`;
      } else {
        const list = dashMaterialFilter === 'ALL' ? tanks : dashMaterialFilter === 'EMPTY' ? emptyTanks : tanks.filter(t => t.materials.some(m => m.material_name === dashMaterialFilter && m.balance_kg > 0.0001));
        tanksHtml = list.length === 0
          ? `<div class="card c-muted" style="text-align:center;">No tanks match the selected filter.</div>`
          : `<div class="tank-grid ${list.length === 1 ? 'single' : ''}">${list.map(renderTankCard).join('')}</div>`;
      }

      return `
        <div style="display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;">
          <div class="seg-bar">
            <button class="seg-btn ${dashMaterialFilter === 'ALL' ? 'active' : ''}" onclick="setDashFilter('ALL')">All Materials (${tanks.length})</button>
            ${matStats.map(s => `<button class="seg-btn ${dashMaterialFilter === s.name ? 'active' : ''}" onclick="setDashFilter('${esc(s.name)}')">${esc(s.name)} (${s.tanks.length})</button>`).join('')}
            <button class="seg-btn ${dashMaterialFilter === 'EMPTY' ? 'active' : ''}" onclick="setDashFilter('EMPTY')">Empty Tanks (${emptyTanks.length})</button>
          </div>
          <div class="seg-bar">
            <button class="seg-btn ${dashViewMode === 'by-material' ? 'active' : ''}" onclick="setDashMode('by-material')">Grouped by Material</button>
            <button class="seg-btn ${dashViewMode === 'all-tanks' ? 'active' : ''}" onclick="setDashMode('all-tanks')">Sequential (Tank 01–${String(tanks.length).padStart(2, '0')})</button>
          </div>
        </div>

        <div class="mat-grid">
          ${matStats.map(s => `
            <div class="card" style="cursor:pointer;${dashMaterialFilter === s.name ? 'border-color:var(--blue);' : ''}" onclick="setDashFilter('${dashMaterialFilter === s.name ? 'ALL' : esc(s.name)}')">
              <div style="display:flex;justify-content:space-between;border-bottom:1px solid var(--border);padding-bottom:10px;">
                <div>
                  <strong>${esc(s.name)}</strong>
                  <div class="c-muted" style="font-size:12px;">${s.tanks.length ? 'Stored in: ' + s.tanks.map(t => t.name).join(', ') : 'No active tanks holding stock'}</div>
                </div>
                <div class="right">
                  <div class="mono c-blue" style="font-size:17px;font-weight:700;">${fmtMT(s.bal / 1000)} MT</div>
                  <div class="mono c-muted" style="font-size:11px;">${fmtKG(s.bal)} KG</div>
                </div>
              </div>
              <div style="display:flex;justify-content:space-between;padding-top:10px;font-size:12px;">
                <div><span class="c-muted">Inward:</span> <strong class="mono c-green">+${fmtMT(s.inKg / 1000)} MT</strong></div>
                <div><span class="c-muted">Outward:</span> <strong class="mono c-red">-${fmtMT(s.outKg / 1000)} MT</strong></div>
              </div>
            </div>`).join('')}
        </div>

        <div class="kpi-grid">
          <div class="card"><div class="c-muted" style="font-size:12px;">Total Tank Capacity</div><div class="mono" style="font-size:20px;font-weight:700;margin-top:6px;">${fmtMT(kpi.cap / 1000)} MT</div><div class="mono c-muted" style="font-size:11px;">${fmtKG(kpi.cap)} KG</div></div>
          <div class="card"><div class="c-blue" style="font-size:12px;">Total Available Stock</div><div class="mono c-blue" style="font-size:20px;font-weight:700;margin-top:6px;">${fmtMT(kpi.stock / 1000)} MT</div><div class="mono c-muted" style="font-size:11px;">${fmtKG(kpi.stock)} KG</div></div>
          <div class="card"><div class="c-muted" style="font-size:12px;">Total Empty Capacity</div><div class="mono" style="font-size:20px;font-weight:700;margin-top:6px;">${fmtMT(kpi.empty / 1000)} MT</div><div class="mono c-muted" style="font-size:11px;">${fmtKG(kpi.empty)} KG</div></div>
          <div class="card"><div class="c-green" style="font-size:12px;">Total Inward Today</div><div class="mono c-green" style="font-size:20px;font-weight:700;margin-top:6px;">+${fmtMT(kpi.inToday / 1000)} MT</div><div class="mono c-muted" style="font-size:11px;">${fmtKG(kpi.inToday)} KG</div></div>
          <div class="card"><div class="c-red" style="font-size:12px;">Total Outward Today</div><div class="mono c-red" style="font-size:20px;font-weight:700;margin-top:6px;">-${fmtMT(kpi.outToday / 1000)} MT</div><div class="mono c-muted" style="font-size:11px;">${fmtKG(kpi.outToday)} KG</div></div>
          <div class="card"><div class="c-muted" style="font-size:12px;">Total Number of Tanks</div><div class="mono" style="font-size:20px;font-weight:700;margin-top:6px;">${kpi.count} ${kpi.count === 1 ? 'Tank' : 'Tanks'}</div><div class="c-muted" style="font-size:11px;">${dashMaterialFilter === 'ALL' ? 'Active storage units' : esc(dashMaterialFilter)}</div></div>
        </div>

        <div style="display:flex;flex-direction:column;gap:18px;">${tanksHtml}</div>

