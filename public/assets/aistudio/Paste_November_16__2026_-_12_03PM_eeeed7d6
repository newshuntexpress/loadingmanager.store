<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>PetroVault Tank Inventory</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet" />
  <style>
    :root {
      --bg: #f8fafc;
      --surface: #ffffff;
      --surface-alt: #f1f5f9;
      --border: #e2e8f0;
      --text: #0f172a;
      --muted: #64748b;
      --sidebar: #0f172a;
      --sidebar-text: #cbd5e1;
      --blue: #0284c7;
      --blue-soft: #e0f2fe;
      --green: #16a34a;
      --green-soft: #dcfce7;
      --red: #dc2626;
      --red-soft: #fee2e2;
      --grey: #94a3b8;
    }
    html.dark {
      --bg: #020617;
      --surface: #0f172a;
      --surface-alt: #1e293b;
      --border: #1e293b;
      --text: #f8fafc;
      --muted: #94a3b8;
      --blue: #38bdf8;
      --blue-soft: rgba(56, 189, 248, 0.14);
      --green-soft: rgba(22, 163, 74, 0.15);
      --red-soft: rgba(220, 38, 38, 0.15);
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: 'DM Sans', system-ui, -apple-system, sans-serif;
      background: var(--bg);
      color: var(--text);
      line-height: 1.5;
    }
    h1, h2, h3, h4, .display { font-family: 'Plus Jakarta Sans', system-ui, sans-serif; margin: 0; }
    .mono { font-family: 'IBM Plex Mono', ui-monospace, monospace; font-variant-numeric: tabular-nums; }
    .app-shell { display: flex; min-height: 100vh; }

    /* Sidebar */
    .sidebar {
      width: 256px;
      background: var(--sidebar);
      color: #f8fafc;
      border-right: 1px solid #1e293b;
      display: flex;
      flex-direction: column;
      position: fixed;
      inset: 0 auto 0 0;
      z-index: 30;
    }
    .sidebar-brand { padding: 20px; border-bottom: 1px solid #1e293b; }
    .sidebar-brand .title { font-size: 18px; font-weight: 800; color: #fff; }
    .sidebar-brand .sub { font-size: 12px; color: #94a3b8; margin-top: 2px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .nav-list { flex: 1; padding: 14px 12px; display: flex; flex-direction: column; gap: 4px; overflow-y: auto; }
    .nav-btn {
      width: 100%;
      border: 0;
      background: transparent;
      color: var(--sidebar-text);
      padding: 10px 14px;
      border-radius: 8px;
      text-align: left;
      font-size: 14px;
      font-weight: 500;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 10px;
      transition: background 0.15s, color 0.15s;
    }
    .nav-btn:hover { background: #1e293b; color: #fff; }
    .nav-btn.active { background: #0284c7; color: #fff; font-weight: 600; }
    .sidebar-footer { padding: 14px 20px; border-top: 1px solid #1e293b; font-size: 12px; color: #94a3b8; }
    .sidebar-footer strong { color: #f8fafc; display: block; }

    /* Main Content */
    .main-wrap { flex: 1; margin-left: 256px; display: flex; flex-direction: column; min-width: 0; }
    .topbar {
      position: sticky;
      top: 0;
      z-index: 20;
      background: var(--surface);
      border-bottom: 1px solid var(--border);
      padding: 12px 24px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
    }
    .topbar-left { display: flex; align-items: center; gap: 10px; font-size: 14px; }
    .topbar-actions { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
    .mobile-menu-btn { display: none; }
    .content { padding: 24px; max-width: 1560px; width: 100%; margin: 0 auto; display: flex; flex-direction: column; gap: 22px; }

    /* Buttons & Inputs */
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      padding: 8px 14px;
      border-radius: 8px;
      border: 1px solid var(--border);
      background: var(--surface);
      color: var(--text);
      font-size: 12px;
      font-weight: 600;
      cursor: pointer;
      white-space: nowrap;
      transition: opacity 0.15s, background 0.15s;
    }
    .btn:hover { opacity: 0.92; }
    .btn:disabled { opacity: 0.5; cursor: not-allowed; }
    .btn-green { background: #16a34a; border-color: #16a34a; color: #fff; }
    .btn-red { background: #dc2626; border-color: #dc2626; color: #fff; }
    .btn-blue { background: #0284c7; border-color: #0284c7; color: #fff; }
    .btn-dark { background: #0f172a; border-color: #0f172a; color: #fff; }
    html.dark .btn-dark { background: #0284c7; border-color: #0284c7; }

    input, select, textarea {
      width: 100%;
      padding: 8px 11px;
      border-radius: 8px;
      border: 1px solid var(--border);
      background: var(--surface);
      color: var(--text);
      font-size: 13px;
      font-family: inherit;
    }
    input:focus, select:focus, textarea:focus { outline: 2px solid #0284c7; outline-offset: -1px; }
    label { display: block; font-size: 12px; font-weight: 600; margin-bottom: 5px; color: var(--text); }

    /* Cards & Grids */
    .card { background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 18px; }
    .kpi-grid { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 14px; }
    .mat-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 14px; }
    .tank-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; }
    .tank-grid.single { grid-template-columns: 1fr; }
    .tank-card-body { display: grid; grid-template-columns: 250px 1fr; gap: 20px; align-items: center; margin-top: 14px; }
    .tank-svg-box {
      background: var(--surface-alt);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 12px 8px;
      display: flex;
      flex-direction: column;
      align-items: center;
    }
    .tank-metrics-top { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; }
    .metric-box { border: 1px solid var(--border); background: var(--surface-alt); border-radius: 8px; padding: 10px 12px; }
    .metric-table { border: 1px solid var(--border); border-radius: 8px; overflow: hidden; margin-top: 12px; }
    .metric-row { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-bottom: 1px solid var(--border); }
    .metric-row:last-child { border-bottom: 0; }
    .metric-cell { padding: 8px 10px; font-size: 12px; display: flex; justify-content: space-between; gap: 6px; border-right: 1px solid var(--border); }
    .metric-cell:last-child { border-right: 0; }

    /* Segmented Tabs */
    .seg-bar { display: inline-flex; flex-wrap: wrap; gap: 4px; padding: 4px; background: var(--surface-alt); border: 1px solid var(--border); border-radius: 9px; }
    .seg-btn {
      border: 0;
      background: transparent;
      color: var(--muted);
      padding: 6px 12px;
      border-radius: 6px;
      font-size: 12px;
      font-weight: 600;
      cursor: pointer;
    }
    .seg-btn.active { background: var(--surface); color: var(--text); box-shadow: 0 1px 2px rgba(0,0,0,0.06); }

    /* Tables */
    .table-wrap { overflow-x: auto; border: 1px solid var(--border); border-radius: 12px; background: var(--surface); }
    table { width: 100%; border-collapse: collapse; font-size: 12px; text-align: left; }
    th { background: var(--surface-alt); color: var(--muted); font-weight: 600; padding: 10px 12px; border-bottom: 1px solid var(--border); white-space: nowrap; }
    td { padding: 10px 12px; border-bottom: 1px solid var(--border); vertical-align: middle; }
    tr:last-child td { border-bottom: 0; }
    tr:hover td { background: rgba(148, 163, 184, 0.06); }
    .right { text-align: right; }

    /* Text Colors */
    .c-blue { color: var(--blue); }
    .c-green { color: var(--green); }
    .c-red { color: var(--red); }
    .c-muted { color: var(--muted); }

    /* Modals & Toast */
    .modal-backdrop {
      position: fixed;
      inset: 0;
      z-index: 60;
      background: rgba(2, 6, 23, 0.65);
      display: none;
      align-items: center;
      justify-content: center;
      padding: 16px;
      overflow-y: auto;
    }
    .modal-backdrop.open { display: flex; }
    .modal {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 14px;
      width: 100%;
      max-width: 640px;
      box-shadow: 0 20px 50px rgba(0,0,0,0.25);
      overflow: hidden;
    }
    .modal-head { padding: 16px 20px; border-bottom: 1px solid var(--border); display: flex; justify-content: space-between; align-items: center; gap: 12px; }
    .modal-body { padding: 20px; display: flex; flex-direction: column; gap: 14px; }
    .modal-foot { padding: 14px 20px; border-top: 1px solid var(--border); display: flex; justify-content: flex-end; gap: 10px; }
    .form-grid-2 { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
    .form-grid-3 { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }

    .toast {
      position: fixed;
      bottom: 20px;
      right: 20px;
      z-index: 80;
      padding: 12px 16px;
      border-radius: 10px;
      font-size: 13px;
      font-weight: 500;
      color: #fff;
      display: none;
      max-width: 420px;
      box-shadow: 0 10px 25px rgba(0,0,0,0.25);
    }
    .toast.show { display: block; }
    .toast.success { background: #064e3b; border: 1px solid #059669; }
    .toast.error { background: #7f1d1d; border: 1px solid #dc2626; }
    .error-banner { padding: 10px 12px; border-radius: 8px; background: var(--red-soft); color: var(--red); font-size: 12px; font-weight: 600; }

    @media (max-width: 1280px) {
      .kpi-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
      .tank-grid { grid-template-columns: 1fr; }
    }
    @media (max-width: 960px) {
      .sidebar { transform: translateX(-100%); transition: transform 0.2s; }
      .sidebar.open { transform: translateX(0); }
      .main-wrap { margin-left: 0; }
      .mobile-menu-btn { display: inline-flex; }
      .tank-card-body { grid-template-columns: 1fr; }
      .kpi-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .form-grid-2, .form-grid-3, .tank-metrics-top, .metric-row { grid-template-columns: 1fr; }
    }
    @media print {
      .sidebar, .topbar, .no-print { display: none !important; }
      .main-wrap { margin-left: 0 !important; }
      body { background: #fff !important; color: #0f172a !important; }
    }
  </style>
</head>
<body>
  <div class="app-shell">
    <!-- Sidebar -->
    <aside id="sidebar" class="sidebar">
      <div class="sidebar-brand">
        <div class="title">PetroVault</div>
        <div id="brand-facility" class="sub">Bulk Liquid Terminal — Sector 4</div>
      </div>
      <nav class="nav-list" aria-label="Primary Navigation">
        <button class="nav-btn active" data-nav="dashboard">Dashboard</button>
        <button class="nav-btn" data-nav="tanks">Tank Management</button>
        <button class="nav-btn" data-nav="inward">Material Inward</button>
        <button class="nav-btn" data-nav="outward">Material Outward</button>
        <button class="nav-btn" data-nav="history">Transaction History</button>
        <button class="nav-btn" data-nav="reports">Stock Reports</button>
        <button class="nav-btn" data-nav="settings">Settings</button>
      </nav>
      <div class="sidebar-footer">
        <strong id="sidebar-operator">Plant Operations Manager</strong>
        <span id="sidebar-role">Terminal Supervisor</span>
      </div>
    </aside>

    <!-- Main Workspace -->
    <div class="main-wrap">
      <header class="topbar">
        <div class="topbar-left">
          <button type="button" class="btn mobile-menu-btn" onclick="toggleMobileSidebar()">Menu</button>
          <span class="c-muted">PetroVault /</span>
          <strong id="page-title">Dashboard</strong>
        </div>
        <div class="topbar-actions">
          <button type="button" class="btn btn-green" onclick="openTxModal('INWARD')">+ Inward Entry</button>
          <button type="button" class="btn btn-red" onclick="openTxModal('OUTWARD')">- Outward Entry</button>
        </div>
      </header>

      <main id="app-content" class="content"></main>
    </div>
  </div>

  <!-- Transaction Modal -->
  <div id="tx-modal-backdrop" class="modal-backdrop">
    <div class="modal">
      <div class="modal-head">
        <div>
          <h3 id="tx-modal-title">Add Material Inward Entry</h3>
          <div class="c-muted" style="font-size:12px;">Enter quantity in KG · Automatically converted to MT (1 MT = 1,000 KG)</div>
        </div>
        <button type="button" class="btn" onclick="closeTxModal()">Close</button>
      </div>
      <form id="tx-form" onsubmit="handleTxFormSubmit(event)">
        <div class="modal-body">
          <div id="tx-error" class="error-banner" style="display:none;"></div>
          <div id="tx-step-edit">
            <div class="form-grid-2">
              <div>
                <label>Transaction Date & Time *</label>
                <input id="tx-date" type="datetime-local" required />
              </div>
              <div>
                <label>Tank Selection *</label>
                <select id="tx-tank" onchange="updateTxPreview()" required></select>
              </div>
            </div>
            <div id="tx-tank-info" class="card" style="padding:10px 12px;margin-top:12px;background:var(--surface-alt);font-size:12px;"></div>
            <div class="form-grid-2" style="margin-top:12px;">
              <div>
                <label>Material Name *</label>
                <select id="tx-material" onchange="updateTxPreview()" required></select>
              </div>
              <div>
                <label style="display:flex;justify-content:space-between;">
                  <span>Quantity (KG) *</span>
                  <span id="tx-mt-preview" class="mono c-blue">= 0 MT</span>
                </label>
                <input id="tx-qty" type="number" step="any" min="0.01" placeholder="e.g. 100000" oninput="updateTxPreview()" required />
              </div>
            </div>
            <div class="form-grid-3" style="margin-top:12px;">
              <div>
                <label>Reference Number *</label>
                <input id="tx-ref" type="text" placeholder="PO / DO No." required />
              </div>
              <div>
                <label id="tx-party-label">Supplier Name *</label>
                <input id="tx-party" type="text" placeholder="Vendor / Customer" required />
              </div>
              <div>
                <label>Vehicle Number</label>
                <input id="tx-vehicle" type="text" placeholder="MH-12-TK-4401" style="text-transform:uppercase;" />
              </div>
            </div>
            <div style="margin-top:12px;">
              <label>Remarks</label>
              <textarea id="tx-remarks" rows="2" placeholder="Optional weighbridge notes..."></textarea>
            </div>
          </div>
          <div id="tx-step-confirm" style="display:none;">
            <div class="card" style="background:var(--surface-alt);font-size:13px;">
              <strong>Confirm Transaction</strong>
              <p class="c-muted" style="margin:4px 0 0;font-size:12px;">Please review details and projected tank stock before saving.</p>
              <div id="tx-confirm-summary" style="margin-top:12px;display:grid;grid-template-columns:1fr 1fr;gap:8px;"></div>
            </div>
          </div>
        </div>
        <div class="modal-foot">
          <button type="button" id="tx-back-btn" class="btn" style="display:none;" onclick="setTxConfirmStep(false)">Back to Edit</button>
          <button type="button" class="btn" onclick="closeTxModal()">Cancel</button>
          <button type="submit" id="tx-submit-btn" class="btn btn-green">Review & Confirm</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Tank Modal -->
  <div id="tank-modal-backdrop" class="modal-backdrop">
    <div class="modal" style="max-width:520px;">
      <div class="modal-head">
        <div>
          <h3 id="tank-modal-title">Add New Tank</h3>
          <div class="c-muted" style="font-size:12px;">Configure tank capacity in KG (converted to MT) and depth in meters</div>
        </div>
        <button type="button" class="btn" onclick="closeTankModal()">Close</button>
      </div>
      <form onsubmit="handleTankFormSubmit(event)">
        <div class="modal-body">
          <div id="tank-error" class="error-banner" style="display:none;"></div>
          <div>
            <label>Tank Name *</label>
            <input id="tank-name" type="text" placeholder="e.g. Tank 15" required />
          </div>
          <div class="form-grid-2">
            <div>
              <label style="display:flex;justify-content:space-between;">
                <span>Total Capacity (KG) *</span>
                <span id="tank-mt-preview" class="mono c-blue">= 2,000 MT</span>
              </label>
              <input id="tank-cap" type="number" step="any" min="1" value="2000000" oninput="document.getElementById('tank-mt-preview').textContent = '= ' + fmtMT((Number(this.value)||0)/1000) + ' MT'" required />
            </div>
            <div>
              <label>Tank Depth (Meters) *</label>
              <input id="tank-depth" type="number" step="0.1" min="0.1" value="7" required />
            </div>
          </div>
          <div>
            <label>Location / Bay</label>
            <input id="tank-loc" type="text" value="Main Storage Bay A" />
          </div>
          <div>
            <label>Technical Notes</label>
            <textarea id="tank-notes" rows="2" placeholder="Optional tank calibration remarks..."></textarea>
          </div>
        </div>
        <div class="modal-foot">
          <button type="button" class="btn" onclick="closeTankModal()">Cancel</button>
          <button type="submit" class="btn btn-dark">Save Tank</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Tank Detail Modal -->
  <div id="tank-detail-backdrop" class="modal-backdrop">
    <div class="modal" style="max-width:580px;">
      <div class="modal-head">
        <div>
          <h3 id="detail-title">Tank Details</h3>
          <div id="detail-sub" class="c-muted" style="font-size:12px;"></div>
        </div>
        <div style="display:flex;gap:8px;">
          <button type="button" class="btn" onclick="window.print()">Print / Save PDF</button>
          <button type="button" class="btn" onclick="closeDetailModal()">Close</button>
        </div>
      </div>
      <div id="detail-body" class="modal-body"></div>
    </div>
  </div>

  <div id="toast" class="toast"></div>

  <script>
    const STORAGE_KEY = 'petrovault_tank_inventory_v1';

    function nowLocalInput() {
      const d = new Date();
      const p = n => String(n).padStart(2, '0');
      return `${d.getFullYear()}-${p(d.getMonth() + 1)}-${p(d.getDate())}T${p(d.getHours())}:${p(d.getMinutes())}`;
    }

    function todayPrefix() {
      return nowLocalInput().slice(0, 10);
    }

    function createSeedState() {
      const now = new Date().toISOString();
      const tanks = [];
      for (let i = 1; i <= 14; i++) {
        tanks.push({
          id: i,
          name: `Tank ${String(i).padStart(2, '0')}`,
          total_capacity_kg: 2000000,
          depth_meters: 7,
          location: i <= 7 ? 'Main Storage Bay A' : 'Main Storage Bay B',
          notes: 'Vertical cylindrical bulk storage tank (2,000 MT / 7m)'
        });
      }
      return {
        nextTankId: 15,
        nextTxId: 2,
        nextMatId: 3,
        nextAuditId: 2,
        settings: {
          full_name: 'Plant Operations Manager',
          email: 'operations@petrovault.local',
          role: 'Terminal Supervisor',
          facility_name: 'Bulk Liquid Terminal — Sector 4',
          theme: 'light'
        },
        materials: [
          { id: 1, name: 'ASPHALT 60/70', code: 'ASP-6070', description: 'Penetration grade bitumen 60/70 for paving and industrial applications' },
          { id: 2, name: 'USED OIL', code: 'USE-OIL', description: 'Recovered industrial lubricating and furnace fuel oil' }
        ],
        tanks,
        transactions: [
          {
            id: 1,
            tx_code: `INW-${todayPrefix().replaceAll('-', '')}-0001`,
            type: 'INWARD',
            tx_date: nowLocalInput(),
            tank_id: 1,
            material_name: 'ASPHALT 60/70',
            quantity_kg: 500000,
            quantity_mt: 500,
            reference_number: 'OPN-2026-001',
            party_name: 'National Bitumen Refinery',
            vehicle_number: 'MH-12-TK-4401',
            remarks: 'Opening baseline inventory stock',
            created_at: now
          }
        ],
        auditLogs: [
          {
            id: 1,
            action: 'CREATE',
            entity_type: 'TRANSACTION',
            summary: 'Initialized Tank 01 to Tank 14 (2,000 MT / 7m each) with 500,000 KG ASPHALT 60/70 in Tank 01',
            performed_by: 'System Seed',
            created_at: now
          }
        ]
      };
    }

    function loadState() {
      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        if (raw) return JSON.parse(raw);
      } catch (e) {}
      const seed = createSeedState();
      localStorage.setItem(STORAGE_KEY, JSON.stringify(seed));
      return seed;
    }

    let state = loadState();
    let activeNav = 'dashboard';
    let dashMaterialFilter = 'ALL';
    let dashViewMode = 'by-material';
    let historySubTab = 'ledger';
    let editingMatId = null;
    let regFilters = { search: '', tankId: 'ALL', material: 'ALL', type: 'ALL', start: '', end: '' };
    let repFilters = { tankId: 'ALL', material: 'ALL', start: '', end: '' };

    let txModalState = { mode: 'create', type: 'INWARD', editId: null, confirmStep: false };
    let tankModalEditId = null;

    function saveState() {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
    }

    function esc(str) {
      return String(str ?? '')
        .replaceAll('&', '&amp;')
        .replaceAll('<', '&lt;')
        .replaceAll('>', '&gt;')
        .replaceAll('"', '&quot;');
    }

    function fmtKG(n) {
      return new Intl.NumberFormat('en-US', { maximumFractionDigits: 2 }).format(n || 0);
    }

    function fmtMT(n) {
      return new Intl.NumberFormat('en-US', { maximumFractionDigits: 3 }).format(n || 0);
    }

    function fmtM(n) {
      return new Intl.NumberFormat('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(n || 0);
    }

    function fmtPct(n) {
      return new Intl.NumberFormat('en-US', { minimumFractionDigits: 1, maximumFractionDigits: 2 }).format(n || 0) + '%';
    }

    function fmtDate(dStr) {
      if (!dStr) return 'No transactions yet';
      const d = new Date(dStr);
      if (isNaN(d.getTime())) return dStr;
      return d.toLocaleString('en-US', { year: 'numeric', month: 'short', day: '2-digit', hour: '2-digit', minute: '2-digit' });
    }

    function showToast(type, msg) {
      const el = document.getElementById('toast');
      el.className = `toast show ${type}`;
      el.textContent = msg;
      clearTimeout(window._toastTimer);
      window._toastTimer = setTimeout(() => { el.className = 'toast'; }, 4000);
    }

    function addAudit(action, entityType, summary) {
      state.auditLogs.unshift({
        id: state.nextAuditId++,
        action,
        entity_type: entityType,
        summary,
        performed_by: state.settings.full_name,
        created_at: new Date().toISOString()
      });
    }

    function computeTank(tank, txList = state.transactions) {
      const txs = txList.filter(t => t.tank_id === tank.id);
      let inwardKg = 0;
      let outwardKg = 0;
      let lastTx = null;
      const matMap = {};

      for (const tx of txs) {
        if (!matMap[tx.material_name]) matMap[tx.material_name] = { material_name: tx.material_name, inward_kg: 0, outward_kg: 0 };
        if (tx.type === 'INWARD') {
          inwardKg += tx.quantity_kg;
          matMap[tx.material_name].inward_kg += tx.quantity_kg;
        } else {
          outwardKg += tx.quantity_kg;
          matMap[tx.material_name].outward_kg += tx.quantity_kg;
        }
        if (!lastTx || tx.tx_date > lastTx) lastTx = tx.tx_date;
      }

      const currentKg = inwardKg - outwardKg;
      const capKg = tank.total_capacity_kg;
      const emptyKg = Math.max(0, capKg - currentKg);
      const filledPct = capKg > 0 ? Math.min(100, Math.max(0, (currentKg / capKg) * 100)) : 0;
      const emptyPct = Math.max(0, 100 - filledPct);
      const filledM = tank.depth_meters * (filledPct / 100);
      const emptyM = Math.max(0, tank.depth_meters - filledM);
      const materials = Object.values(matMap).map(m => ({
        ...m,
        balance_kg: m.inward_kg - m.outward_kg,
        balance_mt: (m.inward_kg - m.outward_kg) / 1000
      }));
      const activeProds = materials.filter(m => m.balance_kg > 0.0001).map(m => m.material_name);

      return {
        ...tank,
        total_capacity_mt: capKg / 1000,
        total_inward_kg: inwardKg,
        total_outward_kg: outwardKg,
        current_stock_kg: currentKg,
        current_stock_mt: currentKg / 1000,
        empty_capacity_kg: emptyKg,
        empty_capacity_mt: emptyKg / 1000,
        filled_percentage: filledPct,
        empty_percentage: emptyPct,
        filled_meters: filledM,
        empty_meters: emptyM,
        last_transaction_at: lastTx,
        materials,
        productLabel: activeProds.length ? activeProds.join(', ') : 'Empty'
      };
    }

    function validateAllTanks(txList) {
      for (const tank of state.tanks) {
        const st = computeTank(tank, txList);
        if (st.current_stock_kg < -0.0001) {
          return `Operation rejected: ${tank.name} stock would drop below 0 (${fmtKG(st.current_stock_kg)} KG).`;
        }
        if (st.current_stock_kg > tank.total_capacity_kg + 0.0001) {
          return `Operation rejected: ${tank.name} stock (${fmtKG(st.current_stock_kg)} KG) exceeds capacity (${fmtKG(tank.total_capacity_kg)} KG).`;
        }
        for (const m of st.materials) {
          if (m.balance_kg < -0.0001) {
            return `Operation rejected: ${m.material_name} balance in ${tank.name} would become negative (${fmtKG(m.balance_kg)} KG).`;
          }
        }
      }
      return null;
    }

    function renderTankSVG(tank) {
      const uid = `t${tank.id}`;
      const cylX = 56, cylW = 148, cylTopY = 86, cylBottomY = 318, cylHeight = 232;
      const rx = 74, ry = 18, cx = cylX + rx;
      const fillPct = tank.filled_percentage;
      const liqH = (cylHeight * fillPct) / 100;
      const liqTopY = cylBottomY - liqH;
      const pointerY = Math.min(cylBottomY - 6, Math.max(cylTopY, liqTopY));
      const ticks = [1, 0.75, 0.5, 0.25, 0].map(r => {
        const y = cylBottomY - cylHeight * r;
